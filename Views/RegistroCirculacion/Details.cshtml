@model BibliotecaVirtualWeb.Models.Prestamo

@{
    ViewData["Title"] = "Detalles del Registro";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary">
        <i class="fas fa-info-circle me-2"></i>Detalles del Registro de Circulación
    </h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit me-1"></i>Editar
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Libro</dt>
            <dd class="col-sm-9">
                <strong>@Model.Libro.Titulo</strong><br>
                <small class="text-muted">@Model.Libro.Autor</small>
            </dd>
            <dt class="col-sm-3">Usuario</dt>
            <dd class="col-sm-9">
                <strong>@Model.Usuario.NombreCompleto</strong><br>
                <small class="text-muted">RUT: @Model.Usuario.RUT</small>
            </dd>
            <dt class="col-sm-3">Fecha de Préstamo</dt>
            <dd class="col-sm-9">@Model.FechaPrestamo.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Fecha de Vencimiento</dt>
            <dd class="col-sm-9">
                @Model.FechaVencimiento.ToString("dd/MM/yyyy")
                @if (Model.EstaVencido)
                {
                    <span class="badge bg-danger ms-2">Vencido</span>
                }
                else if (Model.EstaPorVencer)
                {
                    <span class="badge bg-warning ms-2">Por vencer</span>
                }
            </dd>
            <dt class="col-sm-3">Días Restantes</dt>
            <dd class="col-sm-9">
                @if (Model.Estado == "Devuelto")
                {
                    <span class="text-muted">Ya devuelto</span>
                }
                else if (Model.DiasRestantes < 0)
                {
                    <span class="text-danger">Vencido hace @Math.Abs(Model.DiasRestantes) días</span>
                }
                else
                {
                    <span class="text-success">@Model.DiasRestantes días</span>
                }
            </dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><span class="@Model.EstadoBadgeClass">@Model.EstadoDescripcion</span></dd>
            @if (Model.FechaDevolucion.HasValue)
            {
                <dt class="col-sm-3">Fecha de Devolución</dt>
                <dd class="col-sm-9">@Model.FechaDevolucion.Value.ToString("dd/MM/yyyy HH:mm")</dd>
            }
        </dl>
    </div>
</div>

