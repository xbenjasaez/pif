@model IEnumerable<BibliotecaVirtualWeb.Models.StaffUserListItemViewModel>
@{
    ViewData["Title"] = "Usuarios del sistema";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 text-primary mb-1"><i class="fas fa-users-cog me-2"></i>Usuarios internos</h1>
        <p class="text-muted mb-0">Control total de cuentas con acceso al sistema</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-1"></i>Nuevo usuario
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Roles</th>
                            <th>Fecha registro</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@(user.NombreCompleto ?? "Sin nombre")</strong>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @foreach (var rol in user.Roles)
                                    {
                                        <span class="badge bg-light text-dark me-1">@rol</span>
                                    }
                                </td>
                                <td>@user.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-edit me-1"></i>Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-user-lock fa-3x mb-3"></i>
                <p class="mb-0">Aún no hay usuarios internos registrados.</p>
            </div>
        }
    </div>
</div>

