@model BibliotecaVirtualWeb.Models.EditStaffUserViewModel
@{
    ViewData["Title"] = "Editar usuario interno";
}

<div class="mb-4">
    <h1 class="h3 text-primary mb-1"><i class="fas fa-user-edit me-2"></i>Editar usuario interno</h1>
    <p class="text-muted mb-0">Actualiza la información, rol y contraseña temporal del usuario seleccionado</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <div class="col-md-6">
                <label asp-for="NombreCompleto" class="form-label fw-semibold"></label>
                <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre y apellido" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" placeholder="usuario@colegio.cl" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="RolSeleccionado" class="form-label fw-semibold"></label>
                <select asp-for="RolSeleccionado" class="form-select" asp-items="Model.RolesDisponibles">
                    <option value="">Sin rol asignado</option>
                </select>
                <span asp-validation-for="RolSeleccionado" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="NuevaPassword" class="form-label fw-semibold"></label>
                <input asp-for="NuevaPassword" class="form-control" id="NuevaPasswordInput" />
                <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                <div class="form-text text-danger fw-semibold" id="password-warning" style="display:none;">
                    Esta acción restablecerá la contraseña y obligará al usuario a usar la nueva clave al iniciar sesión.
                </div>
                <div class="form-text">Déjalo vacío si no deseas cambiar la contraseña.</div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Volver
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        (function () {
            const passwordInput = document.getElementById('NuevaPasswordInput');
            const warning = document.getElementById('password-warning');
            if (!passwordInput || !warning) return;

            passwordInput.addEventListener('input', function () {
                warning.style.display = this.value.trim().length > 0 ? 'block' : 'none';
            });
        })();
    </script>
}

