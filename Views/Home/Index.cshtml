@model BibliotecaVirtualWeb.Controllers.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var disponibilidad = Model.TotalEjemplares > 0
        ? (Model.LibrosDisponibles * 100.0 / Model.TotalEjemplares).ToString("F1")
        : "0";
}

<div class="dashboard-hero card border-0 shadow-sm text-white mb-4">
    <div class="card-body d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between">
        <div>
            <p class="text-white-50 mb-1">Actualizado @DateTime.Now.ToString("dddd dd 'de' MMMM")</p>
            <h1 class="display-6 fw-bold mb-3">Hola, bienvenido al panel general</h1>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-light text-primary">Libros: @Model.TotalLibros</span>
                <span class="badge bg-light text-primary">Usuarios: @Model.TotalUsuarios</span>
                <span class="badge bg-light text-primary">Disponibilidad: @disponibilidad%</span>
            </div>
        </div>
        <div class="mt-3 mt-lg-0 d-flex flex-wrap gap-2">
            <a asp-controller="Prestamos" asp-action="PrestamoRapido" class="btn btn-light text-primary">
                <i class="fas fa-qrcode me-1"></i> Préstamo rápido
            </a>
            <a asp-controller="Prestamos" asp-action="DevolucionRapida" class="btn btn-outline-light">
                <i class="fas fa-barcode me-1"></i> Devolución rápida
            </a>
        </div>
    </div>
</div>

@if (Model.AlertasActivas.Any())
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-danger"><i class="fas fa-bell me-2"></i>Alertas del sistema</h5>
            <small class="text-muted">Atiende estas incidencias</small>
        </div>
        <div class="card-body">
            <div class="list-group list-group-flush">
                @foreach (var alerta in Model.AlertasActivas)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start px-0">
                        <div>
                            <div class="fw-semibold text-danger">@alerta.Titulo</div>
                            <div class="small text-muted">@alerta.Mensaje</div>
                            <div class="text-muted tiny">@alerta.Fecha.ToLocalTime().ToString("dd/MM HH:mm")</div>
                        </div>
                        <span class="badge bg-danger-subtle text-danger">Pendiente</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (Model.KpiLabels.Any())
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Actividad mensual</h5>
            <small class="text-muted">Últimos 6 meses</small>
        </div>
        <div class="card-body">
            <canvas id="prestamosChart" height="120"></canvas>
        </div>
    </div>
}

<!-- Estadísticas -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-primary-subtle text-primary">
                <i class="fas fa-book"></i>
            </div>
            <div>
                <p class="text-muted mb-1">Total libros</p>
                <h4 class="mb-0">@Model.TotalLibros</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-success-subtle text-success">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <p class="text-muted mb-1">Ejemplares disponibles</p>
                <h4 class="mb-0">@Model.LibrosDisponibles</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-warning-subtle text-warning">
                <i class="fas fa-hand-holding"></i>
            </div>
            <div>
                <p class="text-muted mb-1">Ejemplares prestados</p>
                <h4 class="mb-0">@Model.LibrosPrestados</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-danger-subtle text-danger">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div>
                <p class="text-muted mb-1">Préstamos vencidos</p>
                <h4 class="mb-0">@Model.PrestamosVencidos</h4>
            </div>
        </div>
    </div>
</div>

<!-- Actividad -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-book me-2 text-primary"></i>Libros recientes</h5>
                <a asp-controller="Libros" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todos</a>
            </div>
            <div class="card-body">
                @if (Model.LibrosRecientes.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var libro in Model.LibrosRecientes)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <h6 class="mb-1">@libro.Titulo</h6>
                                    <small class="text-muted">@libro.Autor</small>
                                </div>
                                <span class="@libro.EstadoBadgeClass">@libro.Estado</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-book fa-3x mb-2"></i>
                        <p class="mb-0">No hay libros registrados aún.</p>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-warning"><i class="fas fa-clock me-2"></i>Préstamos por vencer</h5>
                <a asp-controller="Prestamos" asp-action="Index" class="btn btn-sm btn-outline-warning text-warning">Ver detalle</a>
            </div>
            <div class="card-body">
                @if (Model.PrestamosPorVencer.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var prestamo in Model.PrestamosPorVencer)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <h6 class="mb-1">@prestamo.TituloLibro</h6>
                                    <small class="text-muted">@prestamo.NombreUsuario · Vence @prestamo.FechaVencimiento.ToString("dd/MM")</small>
                                </div>
                                <span class="@prestamo.EstadoBadgeClass">@prestamo.DiasRestantes días</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-check-circle fa-3x mb-2 text-success"></i>
                        <p class="mb-0">No hay préstamos por vencer en los próximos días.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Acciones rápidas -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-transparent border-0">
        <h5 class="mb-0"><i class="fas fa-bolt me-2 text-primary"></i>Acciones rápidas</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <a asp-controller="Libros" asp-action="Create" class="quick-action">
                    <i class="fas fa-plus-circle fa-2x mb-2"></i>
                    <span>Agregar libro</span>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Usuarios" asp-action="Create" class="quick-action">
                    <i class="fas fa-user-plus fa-2x mb-2"></i>
                    <span>Nuevo estudiante</span>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Prestamos" asp-action="Create" class="quick-action">
                    <i class="fas fa-hand-holding fa-2x mb-2"></i>
                    <span>Registrar préstamo</span>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Reportes" asp-action="Index" class="quick-action">
                    <i class="fas fa-chart-bar fa-2x mb-2"></i>
                    <span>Ver reportes</span>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-hero {
        background: linear-gradient(120deg, #4b6bff, #8f9efc);
    }
    .metric-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        border-radius: 1rem;
        padding: 1rem 1.5rem;
    }
    .metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
    }
    .quick-action {
        border: 1px solid #e1e5f2;
        border-radius: 1rem;
        padding: 1.25rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: inherit;
        text-decoration: none;
        transition: all .2s ease;
    }
    .quick-action:hover {
        border-color: #4b6bff;
        color: #4b6bff;
        box-shadow: 0 0.5rem 1rem rgba(75,107,255,.15);
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            const canvas = document.getElementById('prestamosChart');
            if (!canvas) return;

            const labels = @Html.Raw(JsonSerializer.Serialize(Model.KpiLabels));
            const prestamos = @Html.Raw(JsonSerializer.Serialize(Model.KpiPrestamos));
            const devoluciones = @Html.Raw(JsonSerializer.Serialize(Model.KpiDevoluciones));

            new Chart(canvas, {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Préstamos',
                            data: prestamos,
                            borderColor: '#4b6bff',
                            backgroundColor: 'rgba(75, 107, 255, 0.15)',
                            tension: 0.3,
                            fill: true
                        },
                        {
                            label: 'Devoluciones',
                            data: devoluciones,
                            borderColor: '#1cc88a',
                            backgroundColor: 'rgba(28, 200, 138, 0.15)',
                            tension: 0.3,
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        })();
    </script>
}
