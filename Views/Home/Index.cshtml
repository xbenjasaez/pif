@model BibliotecaVirtualWeb.Controllers.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var disponibilidad = Model.TotalEjemplares > 0
        ? (Model.LibrosDisponibles * 100.0 / Model.TotalEjemplares).ToString("F1")
        : "0";
}

<div class="dashboard-hero card border-0 shadow-sm text-white mb-4">
    <div class="card-body d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between">
        <div>
            <p class="text-white-50 mb-1">@DateTime.Now.ToString("dddd dd 'de' MMMM, yyyy")</p>
            <h1 class="display-6 fw-bold mb-3">Panel de Biblioteca</h1>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-light text-primary"><i class="fas fa-book me-1"></i>@Model.TotalLibros libros</span>
                <span class="badge bg-light text-success"><i class="fas fa-check-circle me-1"></i>@disponibilidad% disponible</span>
                @if (Model.PrestamosVencidos > 0)
                {
                    <span class="badge bg-danger"><i class="fas fa-exclamation-triangle me-1"></i>@Model.PrestamosVencidos vencidos</span>
                }
            </div>
        </div>
        <div class="mt-3 mt-lg-0 d-flex flex-wrap gap-2">
            <a asp-controller="Prestamos" asp-action="PrestamoRapido" class="btn btn-light text-primary">
                <i class="fas fa-qrcode me-1"></i> Préstamo rápido
            </a>
            <a asp-controller="Prestamos" asp-action="DevolucionRapida" class="btn btn-outline-light">
                <i class="fas fa-barcode me-1"></i> Devolución rápida
            </a>
        </div>
    </div>
</div>

<!-- Alertas urgentes -->
@if (Model.PrestamosVencidosHoy.Any())
{
    <div class="alert alert-danger border-danger border-3 shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-start">
            <i class="fas fa-exclamation-circle fa-2x me-3 mt-1"></i>
            <div class="flex-grow-1">
                <h5 class="alert-heading mb-2">
                    <strong>@Model.PrestamosVencidos préstamo(s) vencido(s)</strong>
                </h5>
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            @foreach (var prestamo in Model.PrestamosVencidosHoy.Take(5))
                            {
                                <tr>
                                    <td class="ps-0">
                                        <strong>@prestamo.TituloLibro</strong>
                                        <span class="text-muted small">(@prestamo.CodigoBarras)</span>
                                    </td>
                                    <td>
                                        <i class="fas fa-user me-1"></i>@prestamo.NombreUsuario
                                        @if (!string.IsNullOrEmpty(prestamo.Curso))
                                        {
                                            <span class="badge bg-light text-dark">@prestamo.Curso</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-danger">@prestamo.DiasVencido día(s) vencido</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.PrestamosVencidos > 5)
                {
                    <a asp-controller="Prestamos" asp-action="Index" asp-route-estado="Vencido" class="btn btn-outline-danger btn-sm mt-2">
                        Ver todos los @Model.PrestamosVencidos vencidos
                    </a>
                }
            </div>
        </div>
    </div>
}

@if (Model.AlertasActivas.Any())
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-danger"><i class="fas fa-bell me-2"></i>Alertas del sistema</h5>
            <small class="text-muted">Atiende estas incidencias</small>
        </div>
        <div class="card-body">
            <div class="list-group list-group-flush">
                @foreach (var alerta in Model.AlertasActivas)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start px-0">
                        <div>
                            <div class="fw-semibold text-danger">@alerta.Titulo</div>
                            <div class="small text-muted">@alerta.Mensaje</div>
                            <div class="text-muted tiny">@alerta.Fecha.ToLocalTime().ToString("dd/MM HH:mm")</div>
                        </div>
                        <span class="badge bg-danger-subtle text-danger">Pendiente</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Estadísticas del día -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-primary-subtle text-primary">
                <i class="fas fa-arrow-up"></i>
            </div>
            <div>
                <p class="text-muted mb-1 small">Préstamos hoy</p>
                <h4 class="mb-0">@Model.PrestamosHoy</h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-success-subtle text-success">
                <i class="fas fa-arrow-down"></i>
            </div>
            <div>
                <p class="text-muted mb-1 small">Devoluciones hoy</p>
                <h4 class="mb-0">@Model.DevolucionesHoy</h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-warning-subtle text-warning">
                <i class="fas fa-hand-holding"></i>
            </div>
            <div>
                <p class="text-muted mb-1 small">En préstamo</p>
                <h4 class="mb-0">@Model.LibrosPrestados</h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="metric-card bg-white shadow-sm @(Model.EjemplaresDeteriorados > 0 ? "border-warning" : "")">
            <div class="metric-icon @(Model.EjemplaresDeteriorados > 0 ? "bg-warning text-dark" : "bg-secondary-subtle text-secondary")">
                <i class="fas fa-tools"></i>
            </div>
            <div>
                <p class="text-muted mb-1 small">Deteriorados</p>
                <h4 class="mb-0">@Model.EjemplaresDeteriorados</h4>
            </div>
        </div>
    </div>
</div>

<!-- Inventario general -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-primary-subtle text-primary">
                <i class="fas fa-book"></i>
            </div>
            <div>
                <p class="text-muted mb-1">Total títulos</p>
                <h4 class="mb-0">@Model.TotalLibros</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-info-subtle text-info">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <p class="text-muted mb-1">Total ejemplares</p>
                <h4 class="mb-0">@Model.TotalEjemplares</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-success-subtle text-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <p class="text-muted mb-1">Disponibles</p>
                <h4 class="mb-0">@Model.LibrosDisponibles</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card bg-white shadow-sm">
            <div class="metric-icon bg-secondary-subtle text-secondary">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <p class="text-muted mb-1">Usuarios</p>
                <h4 class="mb-0">@Model.TotalUsuarios</h4>
            </div>
        </div>
    </div>
</div>

@if (Model.KpiLabels.Any())
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Actividad mensual</h5>
            <small class="text-muted">Últimos 6 meses</small>
        </div>
        <div class="card-body">
            <canvas id="prestamosChart" height="120"></canvas>
        </div>
    </div>
}

<!-- Actividad y alertas -->
<div class="row g-3 mb-4">
    <!-- Préstamos por vencer -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-warning"><i class="fas fa-clock me-2"></i>Por vencer (próx. 3 días)</h5>
                <span class="badge bg-warning text-dark">@Model.PrestamosPorVencer.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.PrestamosPorVencer.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Libro</th>
                                    <th>Usuario</th>
                                    <th class="text-end">Vence</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prestamo in Model.PrestamosPorVencer)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-truncate" style="max-width: 150px;" title="@prestamo.TituloLibro">
                                                @prestamo.TituloLibro
                                            </div>
                                            <small class="text-muted">@prestamo.CodigoBarras</small>
                                        </td>
                                        <td>
                                            @prestamo.NombreUsuario
                                            @if (!string.IsNullOrEmpty(prestamo.Curso))
                                            {
                                                <br><small class="badge bg-light text-dark">@prestamo.Curso</small>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (prestamo.DiasRestantes == 0)
                                            {
                                                <span class="badge bg-danger">Hoy</span>
                                            }
                                            else if (prestamo.DiasRestantes == 1)
                                            {
                                                <span class="badge bg-warning text-dark">Mañana</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">@prestamo.DiasRestantes días</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-check-circle fa-3x mb-2 text-success"></i>
                        <p class="mb-0">No hay préstamos por vencer próximamente.</p>
                    </div>
                }
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Prestamos" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">
                    <i class="fas fa-list me-1"></i>Ver todos los préstamos
                </a>
            </div>
        </div>
    </div>

    <!-- Ejemplares deteriorados -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100 @(Model.EjemplaresDeteriorados > 0 ? "border-warning" : "")">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 @(Model.EjemplaresDeteriorados > 0 ? "text-warning" : "")">
                    <i class="fas fa-tools me-2"></i>Ejemplares deteriorados
                </h5>
                @if (Model.EjemplaresDeteriorados > 0)
                {
                    <span class="badge bg-warning text-dark">@Model.EjemplaresDeteriorados</span>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.EjemplaresDeterioradosLista.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Código</th>
                                    <th>Libro</th>
                                    <th>Observación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ejemplar in Model.EjemplaresDeterioradosLista)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Ejemplares" asp-action="Details" asp-route-id="@ejemplar.Id" class="text-decoration-none">
                                                <i class="fas fa-barcode me-1"></i>@ejemplar.CodigoBarras
                                            </a>
                                        </td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 150px;" title="@ejemplar.TituloLibro">
                                                @ejemplar.TituloLibro
                                            </div>
                                            @if (!string.IsNullOrEmpty(ejemplar.Ubicacion))
                                            {
                                                <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i>@ejemplar.Ubicacion</small>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(ejemplar.Notas))
                                            {
                                                <span class="text-warning small" title="@ejemplar.Notas">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                                    @(ejemplar.Notas.Length > 30 ? ejemplar.Notas.Substring(0, 30) + "..." : ejemplar.Notas)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Sin detalles</span>
                                            }
                                            @if (!string.IsNullOrEmpty(ejemplar.PrestadoA))
                                            {
                                                <br><small class="text-danger"><i class="fas fa-user me-1"></i>Prestado</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-thumbs-up fa-3x mb-2 text-success"></i>
                        <p class="mb-0">Todos los ejemplares están en buen estado.</p>
                    </div>
                }
            </div>
            @if (Model.EjemplaresDeteriorados > 0)
            {
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="Ejemplares" asp-action="Index" asp-route-estado="Deteriorado" class="btn btn-sm btn-outline-warning w-100">
                        <i class="fas fa-list me-1"></i>Ver todos los deteriorados
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Libros recientes -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-book me-2 text-primary"></i>Libros agregados recientemente</h5>
                <a asp-controller="Libros" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todos</a>
            </div>
            <div class="card-body">
                @if (Model.LibrosRecientes.Any())
                {
                    <div class="row g-3">
                        @foreach (var libro in Model.LibrosRecientes)
                        {
                            <div class="col-md-4 col-lg">
                                <div class="card h-100 border">
                                    <div class="card-body py-3">
                                        <h6 class="card-title text-truncate mb-1" title="@libro.Titulo">@libro.Titulo</h6>
                                        <p class="card-text text-muted small mb-2">@libro.Autor</p>
                                        <span class="@libro.EstadoBadgeClass">@libro.Estado</span>
                                    </div>
                                    <div class="card-footer bg-transparent py-2">
                                        <a asp-controller="Libros" asp-action="Details" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-primary w-100">
                                            <i class="fas fa-eye me-1"></i>Ver
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-book fa-3x mb-2"></i>
                        <p class="mb-0">No hay libros registrados aún.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Acciones rápidas -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-transparent border-0">
        <h5 class="mb-0"><i class="fas fa-bolt me-2 text-primary"></i>Acciones rápidas</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-6 col-md-3 col-lg-2">
                <a asp-controller="Libros" asp-action="Catalogo" class="quick-action">
                    <i class="fas fa-search fa-2x mb-2"></i>
                    <span>Buscar libro</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a asp-controller="Libros" asp-action="Create" class="quick-action">
                    <i class="fas fa-plus-circle fa-2x mb-2"></i>
                    <span>Agregar libro</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a asp-controller="Usuarios" asp-action="Create" class="quick-action">
                    <i class="fas fa-user-plus fa-2x mb-2"></i>
                    <span>Nuevo usuario</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a asp-controller="Prestamos" asp-action="PrestamoRapido" class="quick-action">
                    <i class="fas fa-qrcode fa-2x mb-2"></i>
                    <span>Préstamo rápido</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a asp-controller="Reportes" asp-action="Index" class="quick-action">
                    <i class="fas fa-chart-bar fa-2x mb-2"></i>
                    <span>Ver reportes</span>
                </a>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <a asp-controller="Importacion" asp-action="Index" class="quick-action">
                    <i class="fas fa-file-import fa-2x mb-2"></i>
                    <span>Importar datos</span>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-hero {
        background: linear-gradient(120deg, #4b6bff, #8f9efc);
    }
    .metric-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        border-radius: 1rem;
        padding: 1rem 1.25rem;
        background-color: var(--surface-bg);
        border: 1px solid var(--border-color);
        color: var(--text-color);
        height: 100%;
    }
    .metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    .quick-action {
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        padding: 1rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: inherit;
        text-decoration: none;
        transition: all .2s ease;
        height: 100%;
        min-height: 100px;
    }
    .quick-action:hover {
        border-color: var(--primary-color);
        color: var(--primary-color);
        box-shadow: 0 0.5rem 1rem rgba(75, 107, 255, .18);
    }
    .quick-action span {
        font-size: 0.85rem;
    }
    .list-group-item {
        background-color: var(--surface-bg);
        border-color: var(--border-color);
        color: var(--text-color);
    }
    .card-header,
    .card-body,
    .card-footer {
        background-color: var(--surface-bg);
        color: var(--text-color);
    }
    .table {
        color: var(--text-color);
    }
    .table-light {
        background-color: var(--surface-bg);
    }
    .text-muted {
        color: var(--muted-text) !important;
    }
    .border-warning {
        border-width: 2px !important;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            const canvas = document.getElementById('prestamosChart');
            if (!canvas) return;

            const labels = @Html.Raw(JsonSerializer.Serialize(Model.KpiLabels));
            const prestamos = @Html.Raw(JsonSerializer.Serialize(Model.KpiPrestamos));
            const devoluciones = @Html.Raw(JsonSerializer.Serialize(Model.KpiDevoluciones));

            new Chart(canvas, {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Préstamos',
                            data: prestamos,
                            borderColor: '#4b6bff',
                            backgroundColor: 'rgba(75, 107, 255, 0.15)',
                            tension: 0.3,
                            fill: true
                        },
                        {
                            label: 'Devoluciones',
                            data: devoluciones,
                            borderColor: '#1cc88a',
                            backgroundColor: 'rgba(28, 200, 138, 0.15)',
                            tension: 0.3,
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        })();
    </script>
}
