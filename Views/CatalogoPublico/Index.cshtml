@model BibliotecaVirtualWeb.Controllers.CatalogoPublicoViewModel
@{
    ViewData["Title"] = "Catálogo de la Biblioteca";
    Layout = "_LayoutPublico";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary">
        <i class="fas fa-book-open me-2"></i>Catálogo de la Biblioteca
    </h1>
</div>

<!-- Buscador -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="busqueda" class="form-label fw-semibold">
                        <i class="fas fa-search me-1"></i>Buscar libro
                    </label>
                    <input type="text" 
                           class="form-control" 
                           id="busqueda" 
                           name="busqueda"
                           value="@Model.Busqueda"
                           placeholder="Título, autor, editorial o ISBN..." />
                </div>
                <div class="col-md-4">
                    <label for="categoria" class="form-label fw-semibold">
                        <i class="fas fa-tag me-1"></i>Categoría
                    </label>
                    <select class="form-select" id="categoria" name="categoria">
                        <option value="">Todas las categorías</option>
                        @foreach (var cat in Model.Categorias)
                        {
                            <option value="@cat" selected="@(Model.CategoriaSeleccionada == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>Buscar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.MostrarResultados)
{
    <!-- Estado inicial -->
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-books fa-4x text-primary mb-3"></i>
            <h4 class="text-muted">¡Bienvenido al catálogo!</h4>
            <p class="text-muted mb-4">
                Escribe el nombre de un libro, autor o tema para ver qué tenemos disponible.
            </p>
            @if (Model.Categorias.Any())
            {
                <p class="text-muted mb-2">O explora por categoría:</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    @foreach (var cat in Model.Categorias.Take(6))
                    {
                        <a href="?categoria=@cat" class="btn btn-outline-primary btn-sm">@cat</a>
                    }
                </div>
            }
        </div>
    </div>
}
else if (Model.Libros.Any())
{
    <!-- Resultados -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">
            <i class="fas fa-list me-1"></i>
            <strong>@Model.TotalResultados</strong> resultado(s)
            @if (!string.IsNullOrEmpty(Model.Busqueda))
            {
                <text> para "<strong>@Model.Busqueda</strong>"</text>
            }
        </span>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-times me-1"></i>Limpiar
        </a>
    </div>

    <div class="row g-4">
        @foreach (var libro in Model.Libros)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0" style="line-height: 1.3;">
                                @libro.Titulo
                            </h5>
                            @if (libro.Disponibilidad.HayDisponibles)
                            {
                                <span class="badge bg-success ms-2">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2">No disponible</span>
                            }
                        </div>
                        
                        <p class="card-text text-muted mb-2">
                            <i class="fas fa-user me-1"></i>@libro.Autor
                        </p>
                        
                        @if (!string.IsNullOrEmpty(libro.Editorial))
                        {
                            <p class="card-text small text-muted mb-2">
                                <i class="fas fa-building me-1"></i>@libro.Editorial
                                @if (libro.Año.HasValue)
                                {
                                    <text> (@libro.Año)</text>
                                }
                            </p>
                        }
                        
                        @if (!string.IsNullOrEmpty(libro.Categoria))
                        {
                            <span class="badge bg-light text-dark mb-2">
                                <i class="fas fa-tag me-1"></i>@libro.Categoria
                            </span>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fas fa-copy me-1"></i>
                                @libro.Disponibilidad.Disponibles / @libro.Disponibilidad.Total ejemplar(es)
                            </small>
                            <a asp-action="Detalle" asp-route-id="@libro.Id" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-eye me-1"></i>Ver
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Sin resultados -->
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-search fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No se encontraron resultados</h4>
            <p class="text-muted mb-4">
                Intenta con otros términos de búsqueda o revisa la ortografía.
            </p>
            <a asp-action="Index" class="btn btn-primary">
                <i class="fas fa-redo me-1"></i>Nueva búsqueda
            </a>
        </div>
    </div>
}
