@model BibliotecaVirtualWeb.Controllers.DetalleLibroPublicoViewModel
@{
    ViewData["Title"] = Model.Titulo;
    Layout = "_LayoutPublico";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary">
        <i class="fas fa-book me-2"></i>Detalle del Libro
    </h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver al catálogo
    </a>
</div>

<div class="row g-4">
    <!-- Información del libro -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>Información del Libro
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h3 class="mb-2">@Model.Titulo</h3>
                        <p class="lead text-muted mb-0">
                            <i class="fas fa-user me-1"></i>@Model.Autor
                        </p>
                    </div>
                    @if (Model.EjemplaresDisponibles > 0)
                    {
                        <span class="badge bg-success fs-6 px-3 py-2">
                            <i class="fas fa-check-circle me-1"></i>Disponible
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6 px-3 py-2">
                            <i class="fas fa-clock me-1"></i>No disponible
                        </span>
                    }
                </div>

                <hr>

                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.Editorial))
                    {
                        <div class="col-sm-6">
                            <dt class="text-muted small">Editorial</dt>
                            <dd class="fw-semibold">
                                <i class="fas fa-building me-1 text-primary"></i>@Model.Editorial
                            </dd>
                        </div>
                    }
                    @if (Model.Año.HasValue)
                    {
                        <div class="col-sm-6">
                            <dt class="text-muted small">Año de publicación</dt>
                            <dd class="fw-semibold">
                                <i class="fas fa-calendar me-1 text-primary"></i>@Model.Año
                            </dd>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ISBN))
                    {
                        <div class="col-sm-6">
                            <dt class="text-muted small">ISBN</dt>
                            <dd class="fw-semibold">
                                <i class="fas fa-barcode me-1 text-primary"></i>@Model.ISBN
                            </dd>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Categoria))
                    {
                        <div class="col-sm-6">
                            <dt class="text-muted small">Categoría</dt>
                            <dd>
                                <span class="badge bg-primary">
                                    <i class="fas fa-tag me-1"></i>@Model.Categoria
                                </span>
                            </dd>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Descripcion))
                {
                    <hr>
                    <h6 class="mb-2"><i class="fas fa-align-left me-2 text-primary"></i>Descripción</h6>
                    <p class="text-muted mb-0">@Model.Descripcion</p>
                }
            </div>
        </div>
    </div>

    <!-- Disponibilidad -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-map-marker-alt me-2"></i>Disponibilidad
                </h5>
            </div>
            <div class="card-body">
                <!-- Resumen -->
                <div class="row text-center mb-4">
                    <div class="col-6">
                        <div class="h2 mb-0 text-success">@Model.EjemplaresDisponibles</div>
                        <small class="text-muted">Disponible(s)</small>
                    </div>
                    <div class="col-6">
                        <div class="h2 mb-0 text-secondary">@Model.TotalEjemplares</div>
                        <small class="text-muted">Total</small>
                    </div>
                </div>

                @if (Model.Ejemplares.Any())
                {
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-list me-1"></i>Ubicaciones
                    </h6>
                    <div class="list-group list-group-flush">
                        @foreach (var ejemplar in Model.Ejemplares)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    @if (!string.IsNullOrEmpty(ejemplar.Ubicacion))
                                    {
                                        <i class="fas fa-bookmark me-1 text-primary"></i>
                                        <span>@ejemplar.Ubicacion</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Sin ubicación</span>
                                    }
                                </div>
                                @if (ejemplar.EstaDisponible)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary" title="@ejemplar.Estado">
                                        <i class="fas fa-times"></i>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p class="mb-0 small">No hay ejemplares registrados</p>
                    </div>
                }

                <div class="alert alert-info mt-4 mb-0 small">
                    <i class="fas fa-info-circle me-1"></i>
                    Para solicitar un préstamo, acércate a la biblioteca con tu credencial de estudiante.
                </div>
            </div>
        </div>
    </div>
</div>
