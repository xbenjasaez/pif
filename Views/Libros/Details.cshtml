@model BibliotecaVirtualWeb.Models.Libro

@{
    ViewData["Title"] = "Detalles del Libro";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-book-open me-2"></i>Detalles del Libro</h1>
    <div>
        <a asp-controller="Ejemplares" asp-action="Index" asp-route-libroId="@Model.Id" class="btn btn-info">
            <i class="fas fa-copy me-1"></i>Gestionar Ejemplares
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-1"></i>Editar</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Volver</a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Título</dt>
            <dd class="col-sm-9">@Model.Titulo</dd>
            <dt class="col-sm-3">Autor</dt>
            <dd class="col-sm-9">@Model.Autor</dd>
            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@Model.ISBN</dd>
            <dt class="col-sm-3">Categoría</dt>
            <dd class="col-sm-9">@Model.Categoria</dd>
            <dt class="col-sm-3">Año</dt>
            <dd class="col-sm-9">@Model.Año</dd>
            <dt class="col-sm-3">Editorial</dt>
            <dd class="col-sm-9">@Model.Editorial</dd>
            <dt class="col-sm-3">Ubicación</dt>
            <dd class="col-sm-9">@Model.Ubicacion</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><span class="@Model.EstadoBadgeClass">@Model.Estado</span></dd>
            <dt class="col-sm-3">Proveedor</dt>
            <dd class="col-sm-9">@Model.Proveedor?.Nombre</dd>
            <dt class="col-sm-3">Código de Barras</dt>
            <dd class="col-sm-9">@Model.CodigoBarras</dd>
            <dt class="col-sm-3">Fecha Agregado</dt>
            <dd class="col-sm-9">@Model.FechaAgregado.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@Model.Descripcion</dd>
            <dt class="col-sm-3">Notas</dt>
            <dd class="col-sm-9">@Model.Notas</dd>
        </dl>
    </div>
    
</div>


