@model BibliotecaVirtualWeb.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-book me-2"></i>Editar Libro</h1>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Volver</a>
    
</div>

@if (ViewData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@ViewData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (ViewBag.MostrarAdvertencia == true && ViewBag.PrestamoActivo != null)
{
    var prestamo = ViewBag.PrestamoActivo as BibliotecaVirtualWeb.Models.Prestamo;
    <div class="alert alert-danger border-danger mb-4" role="alert" id="advertenciaPrestamo">
        <div class="d-flex align-items-start">
            <i class="fas fa-exclamation-circle fa-2x me-3 mt-1"></i>
            <div class="flex-grow-1">
                <h5 class="alert-heading mb-3">
                    <i class="fas fa-hand-holding me-2"></i>Libro Actualmente Prestado
                </h5>
                <p class="mb-2">
                    <strong>Este libro está prestado a:</strong>
                </p>
                <div class="bg-light p-3 rounded mb-3">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1"><strong><i class="fas fa-user me-2"></i>Usuario:</strong> @(prestamo?.Usuario?.NombreCompleto ?? "N/A")</p>
                            <p class="mb-1"><strong><i class="fas fa-id-card me-2"></i>RUT:</strong> @(prestamo?.Usuario?.RUT ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong><i class="fas fa-calendar me-2"></i>Fecha de Préstamo:</strong> @(prestamo?.FechaPrestamo.ToString("dd/MM/yyyy") ?? "N/A")</p>
                            <p class="mb-1"><strong><i class="fas fa-calendar-times me-2"></i>Vence:</strong> @(prestamo?.FechaVencimiento.ToString("dd/MM/yyyy") ?? "N/A")</p>
                        </div>
                    </div>
                </div>
                <div class="alert alert-warning mb-3">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Importante:</strong> Si cambias el estado a "Disponible", el sistema marcará automáticamente este préstamo como devuelto. 
                    <strong>Asegúrate de que el usuario haya devuelto físicamente el libro antes de continuar.</strong>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="confirmarDevolucion" name="confirmarDevolucion" value="true" required>
                    <label class="form-check-label" for="confirmarDevolucion">
                        <strong>Confirmo que el usuario ha devuelto físicamente el libro y deseo continuar con el cambio de estado.</strong>
                    </label>
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Estado == "Prestado")
{
    // Si el libro está marcado como Prestado pero no hay ViewBag, verificar si hay préstamo activo
    <div class="alert alert-info mb-4" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Nota:</strong> Este libro está marcado como "Prestado". Si deseas cambiar su estado a "Disponible", asegúrate de que el préstamo haya sido devuelto desde el apartado "Préstamos" o "Registro de Circulación".
    </div>
}

<div class="card shadow">
    <div class="card-body">
        <form asp-action="Edit" method="post" id="formEditLibro">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />
            
            @if (ViewBag.MostrarAdvertencia == true)
            {
                <input type="hidden" name="confirmarDevolucion" id="hiddenConfirmarDevolucion" value="" />
            }

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="Año" class="form-label"></label>
                        <input asp-for="Año" class="form-control" />
                        <span asp-validation-for="Año" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Autor" class="form-label"></label>
                        <input asp-for="Autor" class="form-control" />
                        <span asp-validation-for="Autor" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="ISBN" class="form-label"></label>
                        <input asp-for="ISBN" class="form-control" />
                        <span asp-validation-for="ISBN" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Categoria" class="form-label"></label>
                        <input asp-for="Categoria" class="form-control" />
                        <span asp-validation-for="Categoria" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Editorial" class="form-label"></label>
                        <input asp-for="Editorial" class="form-control" />
                        <span asp-validation-for="Editorial" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Ubicacion" class="form-label">Ubicación Física</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <select id="ubicacionLetra" class="form-select">
                                    <option value="">Seleccione letra</option>
                                    @for (char c = 'A'; c <= 'Z'; c++)
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <input type="number" id="ubicacionRepisa" class="form-control" min="1" max="99" placeholder="Repisa" />
                            </div>
                        </div>
                        <input type="hidden" asp-for="Ubicacion" id="Ubicacion" />
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Formato: Letra (A-Z) y número de repisa (1-99). Ejemplo: A-5
                        </small>
                        <span asp-validation-for="Ubicacion" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Disponible">Disponible</option>
                            <option value="Prestado">Prestado</option>
                            <option value="Reservado">Reservado</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="ProveedorId" class="form-label"></label>
                        <input asp-for="ProveedorId" class="form-control" />
                        <span asp-validation-for="ProveedorId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="CodigoBarras" class="form-label"></label>
                        <input asp-for="CodigoBarras" class="form-control" />
                        <span asp-validation-for="CodigoBarras" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Notas" class="form-label"></label>
                <textarea asp-for="Notas" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notas" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times me-1"></i>Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Guardar</button>
            </div>
        </form>
    </div>
    
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Combinar letra y repisa en el campo de ubicación
        function actualizarUbicacion() {
            const letra = document.getElementById('ubicacionLetra').value;
            const repisa = document.getElementById('ubicacionRepisa').value;
            const ubicacionInput = document.getElementById('Ubicacion');
            
            if (letra && repisa) {
                ubicacionInput.value = letra + '-' + repisa;
            } else {
                ubicacionInput.value = '';
            }
        }
        
        document.getElementById('ubicacionLetra').addEventListener('change', actualizarUbicacion);
        document.getElementById('ubicacionRepisa').addEventListener('input', actualizarUbicacion);
        
        // Si hay un valor existente en Ubicacion, parsearlo
        const ubicacionInicial = document.getElementById('Ubicacion').value;
        if (ubicacionInicial) {
            const match = ubicacionInicial.match(/^([A-Z])-?(\d+)$/);
            if (match) {
                document.getElementById('ubicacionLetra').value = match[1];
                document.getElementById('ubicacionRepisa').value = match[2];
            }
        }
    </script>
    @if (ViewBag.MostrarAdvertencia == true)
    {
        <script>
            (function() {
                const form = document.getElementById('formEditLibro');
                const confirmarCheckbox = document.getElementById('confirmarDevolucion');
                const estadoSelect = document.querySelector('[name="Estado"]');
                const estadoOriginal = '@Model.Estado';
                
                form.addEventListener('submit', function(e) {
                    // Si el estado original era "Prestado" y ahora es "Disponible"
                    if (estadoOriginal === 'Prestado' && estadoSelect && estadoSelect.value === 'Disponible') {
                        if (!confirmarCheckbox || !confirmarCheckbox.checked) {
                            e.preventDefault();
                            alert('⚠️ Por favor, confirma que el usuario ha devuelto físicamente el libro marcando la casilla de confirmación antes de continuar.');
                            if (confirmarCheckbox) {
                                confirmarCheckbox.focus();
                                confirmarCheckbox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                            return false;
                        }
                        
                        // Si el checkbox está marcado, establecer el valor en el campo hidden
                        document.getElementById('hiddenConfirmarDevolucion').value = 'true';
                    }
                });
                
                // Mostrar/ocultar la advertencia según el estado seleccionado
                if (estadoSelect && confirmarCheckbox) {
                    estadoSelect.addEventListener('change', function() {
                        if (this.value === 'Disponible' && estadoOriginal === 'Prestado') {
                            confirmarCheckbox.required = true;
                            confirmarCheckbox.closest('.alert').style.display = 'block';
                        } else {
                            confirmarCheckbox.required = false;
                            confirmarCheckbox.checked = false;
                            if (confirmarCheckbox.closest('.alert')) {
                                confirmarCheckbox.closest('.alert').style.display = 'none';
                            }
                        }
                    });
                }
            })();
        </script>
    }
}


