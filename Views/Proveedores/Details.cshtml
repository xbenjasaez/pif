@model BibliotecaVirtualWeb.Models.Proveedor

@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-truck me-2"></i>Detalles del Proveedor</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-1"></i>Editar</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Volver</a>
    </div>
    
</div>

<div class="card shadow">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>
            <dt class="col-sm-3">Contacto</dt>
            <dd class="col-sm-9">@Model.Contacto</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Telefono</dd>
            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9"><span class="@Model.TipoBadgeClass">@Model.TipoDescripcion</span></dd>
            <dt class="col-sm-3">Libros Proporcionados</dt>
            <dd class="col-sm-9">@Model.LibrosProporcionados</dd>
            <dt class="col-sm-3">Notas</dt>
            <dd class="col-sm-9">@Model.Notas</dd>
        </dl>
    </div>
    
</div>


