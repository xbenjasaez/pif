@model BibliotecaVirtualWeb.Models.Prestamo

@{
    ViewData["Title"] = "Detalles del Préstamo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-hand-holding me-2"></i>Detalles del Préstamo</h1>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Volver</a>
    
</div>

<div class="card shadow">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Libro</dt>
            <dd class="col-sm-9">@Model.Libro.Titulo</dd>
            <dt class="col-sm-3">Usuario</dt>
            <dd class="col-sm-9">@Model.Usuario.NombreCompleto</dd>
            <dt class="col-sm-3">Fecha Préstamo</dt>
            <dd class="col-sm-9">@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Fecha Vencimiento</dt>
            <dd class="col-sm-9">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><span class="@Model.EstadoBadgeClass">@Model.EstadoDescripcion</span></dd>
        </dl>
    </div>
    
</div>


