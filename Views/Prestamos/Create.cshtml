@model BibliotecaVirtualWeb.Models.Prestamo

@{
    ViewData["Title"] = "Nuevo Préstamo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-plus me-2"></i>Nuevo Préstamo</h1>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Volver</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow">
    <div class="card-body">
        <form asp-action="Create" method="post" id="formPrestamo">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="codigoBarrasInput" class="form-label">
                            <i class="fas fa-barcode me-2"></i>Código de Barras del Ejemplar
                        </label>
                        <input type="text" 
                               id="codigoBarrasInput" 
                               class="form-control form-control-lg" 
                               placeholder="Escanea el código de barras con la pistola láser"
                               autocomplete="off"
                               autofocus
                               style="font-size: 1.2rem; letter-spacing: 0.1em;" />
                        <input type="hidden" asp-for="EjemplarId" id="EjemplarId" name="EjemplarId" />
                        <input type="hidden" asp-for="LibroId" id="LibroId" name="LibroId" />
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Escanea el código de barras del ejemplar físico del libro.
                        </small>
                        <span asp-validation-for="EjemplarId" class="text-danger"></span>
                        <div id="ejemplarSeleccionado" class="mt-3" style="display: none;">
                            <div class="alert alert-success py-3 mb-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-2">
                                            <i class="fas fa-check-circle me-2"></i>
                                            <strong>Ejemplar encontrado:</strong>
                                        </h6>
                                        <div class="ms-3">
                                            <p class="mb-1">
                                                <strong><i class="fas fa-book me-2"></i>Libro:</strong> 
                                                <span id="ejemplarLibroTitulo"></span>
                                            </p>
                                            <p class="mb-1">
                                                <strong><i class="fas fa-user me-2"></i>Autor:</strong> 
                                                <span id="ejemplarLibroAutor"></span>
                                            </p>
                                            <p class="mb-0">
                                                <strong><i class="fas fa-barcode me-2"></i>Código:</strong> 
                                                <span id="ejemplarCodigoBarras"></span>
                                            </p>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" id="limpiarEjemplar" title="Limpiar selección">
                                        <i class="fas fa-times me-1"></i>Limpiar
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="ejemplarError" class="alert alert-danger mt-2" style="display: none;">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span id="ejemplarErrorMensaje"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="UsuarioId" class="form-label">
                            <i class="fas fa-user me-2"></i>Usuario
                        </label>
                        <div class="position-relative">
                            <input type="text" 
                                   id="usuarioSearch" 
                                   class="form-control" 
                                   placeholder="Buscar por nombre o RUT (ej: Benjamín, benjamin, 12345678-9)"
                                   autocomplete="off" />
                            <input type="hidden" asp-for="UsuarioId" id="UsuarioId" name="UsuarioId" />
                            <div id="usuarioResults" class="list-group position-absolute w-100 shadow-sm" style="z-index: 1000; display: none; max-height: 300px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.375rem; margin-top: 2px; background-color: white; pointer-events: auto;"></div>
                        </div>
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Busca por nombre completo o RUT. La búsqueda funciona sin tildes (ej: "benjamin" encuentra "Benjamín").
                        </small>
                        <span asp-validation-for="UsuarioId" class="text-danger"></span>
                        <div id="usuarioSeleccionado" class="mt-2" style="display: none;">
                            <div class="alert alert-success py-3 mb-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>Usuario seleccionado:</strong> <span id="usuarioNombreMostrar"></span>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" id="limpiarUsuario" title="Limpiar selección">
                                    <i class="fas fa-times me-1"></i>Limpiar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Período de préstamo:</strong> 15 días. Puedes modificar la fecha de vencimiento desde el <strong>Registro de Circulación</strong> después de crear el préstamo.
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times me-1"></i>Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Crear Préstamo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function() {
            // Elementos de código de barras
            const codigoBarrasInput = document.getElementById('codigoBarrasInput');
            const EjemplarId = document.getElementById('EjemplarId');
            const LibroId = document.getElementById('LibroId');
            const ejemplarSeleccionado = document.getElementById('ejemplarSeleccionado');
            const ejemplarError = document.getElementById('ejemplarError');
            const ejemplarErrorMensaje = document.getElementById('ejemplarErrorMensaje');
            const limpiarEjemplar = document.getElementById('limpiarEjemplar');
            let buscarTimeout;

            // Elementos de usuario (mantener código existente)
            let searchTimeout;
            const usuarioSearch = document.getElementById('usuarioSearch');
            const UsuarioId = document.getElementById('UsuarioId');
            const usuarioResults = document.getElementById('usuarioResults');
            const usuarioSeleccionado = document.getElementById('usuarioSeleccionado');
            const usuarioNombreMostrar = document.getElementById('usuarioNombreMostrar');
            const limpiarUsuario = document.getElementById('limpiarUsuario');

            // Búsqueda de ejemplar por código de barras
            codigoBarrasInput.addEventListener('input', function(e) {
                const codigo = e.target.value.trim();
                
                clearTimeout(buscarTimeout);
                
                if (codigo.length === 0) {
                    ocultarEjemplar();
                    return;
                }

                // Esperar un poco para que el escáner termine de leer (los escáneres suelen enviar Enter al final)
                buscarTimeout = setTimeout(() => {
                    buscarEjemplar(codigo);
                }, 500);
            });

            // También buscar cuando se presiona Enter (comportamiento típico de escáneres)
            codigoBarrasInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const codigo = e.target.value.trim();
                    if (codigo.length > 0) {
                        clearTimeout(buscarTimeout);
                        buscarEjemplar(codigo);
                    }
                }
            });

            function buscarEjemplar(codigo) {
                fetch(`/Prestamos/BuscarEjemplar?codigoBarras=${encodeURIComponent(codigo)}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            mostrarEjemplar(data.ejemplar);
                        } else {
                            mostrarErrorEjemplar(data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error al buscar ejemplar:', error);
                        mostrarErrorEjemplar('Error al buscar el ejemplar. Por favor, intenta de nuevo.');
                    });
            }

            function mostrarEjemplar(ejemplar) {
                EjemplarId.value = ejemplar.id;
                LibroId.value = ejemplar.libro.id;
                document.getElementById('ejemplarLibroTitulo').textContent = ejemplar.libro.titulo;
                document.getElementById('ejemplarLibroAutor').textContent = ejemplar.libro.autor;
                document.getElementById('ejemplarCodigoBarras').textContent = ejemplar.codigoBarras;
                
                ejemplarSeleccionado.style.display = 'block';
                ejemplarError.style.display = 'none';
                codigoBarrasInput.style.borderColor = '';
            }

            function mostrarErrorEjemplar(mensaje) {
                ejemplarErrorMensaje.textContent = mensaje;
                ejemplarError.style.display = 'block';
                ejemplarSeleccionado.style.display = 'none';
                EjemplarId.value = '';
                LibroId.value = '';
                codigoBarrasInput.style.borderColor = '#dc3545';
            }

            function ocultarEjemplar() {
                ejemplarSeleccionado.style.display = 'none';
                ejemplarError.style.display = 'none';
                EjemplarId.value = '';
                LibroId.value = '';
                codigoBarrasInput.style.borderColor = '';
            }

            limpiarEjemplar.addEventListener('click', function(e) {
                e.preventDefault();
                codigoBarrasInput.value = '';
                ocultarEjemplar();
                codigoBarrasInput.focus();
            });

            // Código de búsqueda de usuarios (mantener el existente)
            usuarioSearch.addEventListener('input', function(e) {
                const query = e.target.value.trim();
                
                clearTimeout(searchTimeout);
                
                if (query.length < 2) {
                    usuarioResults.style.display = 'none';
                    return;
                }

                searchTimeout = setTimeout(() => {
                    buscarUsuarios(query);
                }, 300);
            });

            usuarioSearch.addEventListener('focus', function() {
                if (usuarioSearch.value.trim().length >= 2) {
                    buscarUsuarios(usuarioSearch.value.trim());
                }
            });

            document.addEventListener('click', function(e) {
                const target = e.target;
                if (!usuarioSearch.contains(target) && 
                    !usuarioResults.contains(target) && 
                    !usuarioSeleccionado.contains(target)) {
                    setTimeout(() => {
                        usuarioResults.style.display = 'none';
                    }, 150);
                }
            });

            function buscarUsuarios(query) {
                fetch(`/Prestamos/BuscarUsuarios?q=${encodeURIComponent(query)}`)
                    .then(response => response.json())
                    .then(data => {
                        mostrarResultados(data);
                    })
                    .catch(error => {
                        console.error('Error al buscar usuarios:', error);
                        usuarioResults.innerHTML = '<div class="list-group-item text-danger">Error al buscar usuarios</div>';
                    });
            }

            function mostrarResultados(usuarios) {
                if (usuarios.length === 0) {
                    usuarioResults.innerHTML = '<div class="list-group-item text-muted">No se encontraron usuarios</div>';
                    usuarioResults.style.display = 'block';
                    return;
                }

                usuarioResults.innerHTML = usuarios.map(u => 
                    `<div class="list-group-item list-group-item-action usuario-item" 
                          data-id="${u.id}" 
                          data-nombre="${u.texto}" 
                          style="cursor: pointer; user-select: none; pointer-events: auto;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>${u.nombreCompleto}</strong><br>
                                <small class="text-muted"><i class="fas fa-id-card me-1"></i>${u.rut}</small>
                            </div>
                            <i class="fas fa-chevron-right text-muted"></i>
                        </div>
                    </div>`
                ).join('');
                
                usuarioResults.querySelectorAll('.usuario-item').forEach(item => {
                    item.addEventListener('mouseenter', function() {
                        this.style.backgroundColor = '#f8f9fa';
                    });
                    item.addEventListener('mouseleave', function() {
                        this.style.backgroundColor = '';
                    });
                    
                    item.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        const id = this.getAttribute('data-id');
                        const nombre = this.getAttribute('data-nombre');
                        seleccionarUsuario(id, nombre);
                        return false;
                    }, true);
                });

                usuarioResults.style.display = 'block';
            }

            function seleccionarUsuario(id, nombre) {
                UsuarioId.value = id;
                UsuarioId.setAttribute('value', id);
                
                if (usuarioSearch) {
                    usuarioSearch.value = '';
                    usuarioSearch.removeAttribute('required');
                    usuarioSearch.blur();
                }
                
                if (usuarioResults) {
                    usuarioResults.style.display = 'none';
                }
                
                if (usuarioNombreMostrar) {
                    usuarioNombreMostrar.textContent = nombre;
                }
                
                if (usuarioSeleccionado) {
                    usuarioSeleccionado.style.display = 'block';
                }
            }

            limpiarUsuario.addEventListener('click', function(e) {
                e.preventDefault();
                UsuarioId.value = '';
                UsuarioId.removeAttribute('value');
                usuarioSeleccionado.style.display = 'none';
                usuarioSearch.value = '';
                usuarioSearch.focus();
            });

            // Validación antes de enviar
            document.querySelector('form').addEventListener('submit', function(e) {
                const valorEjemplar = EjemplarId.value;
                const valorUsuario = UsuarioId.value;
                
                if (!valorEjemplar || valorEjemplar === '0' || valorEjemplar === '') {
                    e.preventDefault();
                    alert('Por favor, escanea el código de barras del ejemplar.');
                    codigoBarrasInput.focus();
                    return false;
                }
                
                if (!valorUsuario || valorUsuario === '0' || valorUsuario === '') {
                    e.preventDefault();
                    alert('Por favor, selecciona un usuario de la lista de resultados.');
                    usuarioSearch.focus();
                    return false;
                }
            });
        })();
    </script>
}
