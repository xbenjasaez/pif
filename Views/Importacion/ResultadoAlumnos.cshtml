@model BibliotecaVirtualWeb.Services.ResultadoImportacion
@{
    ViewData["Title"] = "Resultado de Validación - Alumnos";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-clipboard-check me-2"></i>Resultado de Validación
            </h1>
            <p class="text-muted mb-0">Revisión de datos de alumnos antes de importar</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>

    <!-- Resumen -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h2 class="text-success mb-0">@Model.TotalNuevos</h2>
                    <small class="text-muted">Alumnos nuevos</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h2 class="text-warning mb-0">@Model.TotalActualizaciones</h2>
                    <small class="text-muted">Alumnos a actualizar</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-body text-center">
                    <h2 class="text-danger mb-0">@Model.TotalErrores</h2>
                    <small class="text-muted">Errores encontrados</small>
                </div>
            </div>
        </div>
    </div>

    @if (Model.TieneErrores)
    {
        <div class="card border-danger mb-4">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Errores encontrados
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    @foreach (var error in Model.Errores.Take(20))
                    {
                        <li class="text-danger"><i class="bi bi-x-circle me-1"></i>@error</li>
                    }
                    @if (Model.Errores.Count > 20)
                    {
                        <li class="text-muted">... y @(Model.Errores.Count - 20) errores más</li>
                    }
                </ul>
            </div>
        </div>
    }

    @if (Model.NuevosRegistros.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="card-title mb-0">
                    <i class="bi bi-plus-circle me-2"></i>Alumnos nuevos (@Model.TotalNuevos)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>#</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int i = 1;}
                            @foreach (var registro in Model.NuevosRegistros)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@registro.Descripcion</td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.ActualizacionesPendientes.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-warning">
                <h5 class="card-title mb-0">
                    <i class="bi bi-pencil me-2"></i>Alumnos a actualizar (@Model.TotalActualizaciones)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>#</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int j = 1;}
                            @foreach (var registro in Model.ActualizacionesPendientes)
                            {
                                <tr>
                                    <td>@j</td>
                                    <td>@registro.Descripcion</td>
                                </tr>
                                j++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Archivo validado -->
    @if (ViewBag.NombreArchivo != null)
    {
        <div class="alert alert-info mb-4">
            <i class="bi bi-file-earmark-text me-2"></i>
            <strong>Archivo validado:</strong> @ViewBag.NombreArchivo
        </div>
    }

    <!-- Acciones -->
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @if (Model.TieneErrores)
                    {
                        <span class="text-danger">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Corrige los errores antes de importar
                        </span>
                    }
                    else if (Model.TotalNuevos == 0 && Model.TotalActualizaciones == 0)
                    {
                        <span class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            No hay cambios para aplicar
                        </span>
                    }
                    else
                    {
                        <span class="text-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Los datos están listos para importar
                        </span>
                    }
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar
                    </a>
                    @if (!Model.TieneErrores && (Model.TotalNuevos > 0 || Model.TotalActualizaciones > 0))
                    {
                        <form asp-action="ConfirmarAlumnos" method="post" class="d-inline" 
                              onsubmit="return confirm('¿Estás seguro de importar @Model.TotalNuevos alumnos nuevos y actualizar @Model.TotalActualizaciones?');">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg me-1"></i>Confirmar importación
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

