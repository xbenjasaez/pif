@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Acceso denegado";
}

<div class="auth-card shadow-lg p-4 bg-white rounded-4 text-center">
    <div class="text-danger mb-3">
        <i class="fas fa-shield-alt fa-3x"></i>
    </div>
    <h1 class="h4 text-danger fw-bold mb-3">Acceso denegado</h1>
    <p class="text-muted mb-4">
        No tienes permisos para ver este contenido. Si crees que es un error, contacta al administrador.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
        <i class="fas fa-home me-2"></i>Volver al panel
    </a>
</div>

