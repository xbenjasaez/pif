@model BibliotecaVirtualWeb.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center align-items-stretch g-4">
    <div class="col-lg-5">
        <div class="auth-card shadow-lg p-4 p-md-5 bg-white rounded-4">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 mb-3" style="width:80px;height:80px;">
                    <i class="fas fa-hat-wizard text-primary" style="font-size: 2.2rem;"></i>
                </div>
                <h1 class="h3 text-primary fw-bold mb-1">Acceso Funcionarios</h1>
                <p class="text-muted mb-0">Ingresa con tu cuenta institucional para administrar la biblioteca</p>
            </div>

            <form asp-action="Login" method="post" class="needs-validation" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-envelope text-primary"></i></span>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="correo@colegio.cl" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-lock text-primary"></i></span>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="********" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label"></label>
                    </div>
                    <small class="text-muted">¿Olvidaste tu contraseña? Contacta al administrador.</small>   
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
                    <i class="fas fa-sign-in-alt me-2"></i>Ingresar
                </button>

                <!-- Botón al catálogo para pantallas pequeñas -->
                <div class="mt-3 pt-3 border-top text-center d-lg-none">
                    <p class="mb-2 text-muted small">¿Solo quieres explorar libros?</p>
                    <a asp-controller="CatalogoPublico" asp-action="Index" class="btn btn-outline-primary w-100 btn-lg">
                        <span class="me-2">
                            <i class="fas fa-rocket"></i>
                        </span>
                        Abrir catálogo público de alumnos
                    </a>
                </div>
            </form>

            <div class="mt-3 d-none d-md-block">
                <div class="row text-muted small text-center">
                    <div class="col-4">
                        <i class="fas fa-dragon text-primary mb-1" style="font-size: 1.5rem;"></i>
                        <p class="mb-0">Descubre mundos</p>
                    </div>
                    <div class="col-4">
                        <i class="fas fa-wand-magic-sparkles text-success mb-1" style="font-size: 1.5rem;"></i>
                        <p class="mb-0">Imagina historias</p>
                    </div>
                    <div class="col-4">
                        <i class="fas fa-star text-warning mb-1" style="font-size: 1.5rem;"></i>
                        <p class="mb-0">Colecciona lecturas</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel derecho para el catálogo público (solo en pantallas grandes) -->
    <div class="col-lg-5 d-none d-lg-block">
        <div class="h-100 rounded-4 text-white p-4 p-md-5 shadow-lg"
             style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(6px);">
            <div class="d-flex align-items-center mb-3">
                <div class="me-3">
                    <div class="bg-warning rounded-circle d-flex align-items-center justify-content-center"
                         style="width:64px;height:64px;">
                        <i class="fas fa-child-reaching text-dark" style="font-size: 1.8rem;"></i>
                    </div>
                </div>
                <div>
                    <h2 class="h5 mb-1">Catálogo público de alumnos</h2>
                    <p class="mb-0 small text-light opacity-75">
                        Explora todos los libros de la biblioteca sin necesidad de iniciar sesión.
                    </p>
                </div>
            </div>

            <ul class="list-unstyled small mb-4">
                <li class="mb-2">
                    <i class="fas fa-check-circle text-success me-2"></i>
                    Buscar libros por título, autor y categoría.
                </li>
                <li class="mb-2">
                    <i class="fas fa-check-circle text-success me-2"></i>
                    Saber cuántos ejemplares hay disponibles.
                </li>
                <li class="mb-0">
                    <i class="fas fa-check-circle text-success me-2"></i>
                    Ideal para que los alumnos elijan qué leer antes de ir a la biblioteca.
                </li>
            </ul>

            <a asp-controller="CatalogoPublico" asp-action="Index"
               id="btnCatalogoPublico"
               class="btn btn-light btn-lg w-100 text-primary fw-semibold rocket-launch-btn">
                <span class="me-2 rocket-icon">
                    <i class="fas fa-rocket"></i>
                </span>
                Abrir catálogo público ahora
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Función para limpiar estado
        function cleanRocketState() {
            document.body.classList.remove('launching-catalog');
            const overlays = document.querySelectorAll('.rocket-overlay');
            overlays.forEach(overlay => overlay.remove());
            const btn = document.getElementById('btnCatalogoPublico');
            if (btn) {
                btn.classList.remove('launching');
            }
        }

        // Limpiar inmediatamente
        cleanRocketState();

        // Limpiar cuando se carga la página
        document.addEventListener('DOMContentLoaded', cleanRocketState);

        // Limpiar cuando se navega (incluyendo volver atrás desde caché)
        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                cleanRocketState();
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            const rocketBtn = document.getElementById('btnCatalogoPublico');
            if (!rocketBtn) return;

            const href = rocketBtn.getAttribute('href');

            rocketBtn.addEventListener('click', function (event) {
                // Dejar que el teclado (Enter/Espacio) funcione sin animación extra
                if (event.pointerType === 'mouse' || event.pointerType === 'pen' || event.type === 'click') {
                    event.preventDefault();
                }

                if (rocketBtn.classList.contains('launching')) {
                    return;
                }

                rocketBtn.classList.add('launching');

                 // Crear overlay de cohete a pantalla completa
                 const overlay = document.createElement('div');
                 overlay.className = 'rocket-overlay';
                 overlay.innerHTML = '<div class="big-rocket"><i class="fas fa-rocket"></i></div>';
                 document.body.appendChild(overlay);

                 // Cambiar fondo mientras despega
                 document.body.classList.add('launching-catalog');

                 // Activar animación
                 requestAnimationFrame(() => {
                     overlay.classList.add('active');
                 });

                // Lanzar el cohete y luego ir al catálogo
                setTimeout(function () {
                    window.location.href = href;
                }, 800);
            });
        });
    </script>
}

