@model BibliotecaVirtualWeb.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-card shadow-lg p-4 p-md-5 bg-white rounded-4">
    <div class="text-center mb-4">
        <h1 class="h3 text-primary fw-bold mb-1">Biblioteca Virtual</h1>
        <p class="text-muted mb-0">Ingresa con tu cuenta institucional</p>
    </div>

    <form asp-action="Login" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold"></label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-envelope text-primary"></i></span>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="correo@colegio.cl" autofocus />
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold"></label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-lock text-primary"></i></span>
                <input asp-for="Password" class="form-control form-control-lg" placeholder="********" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input asp-for="Recordarme" class="form-check-input" />
                <label asp-for="Recordarme" class="form-check-label"></label>
            </div>
            <small class="text-muted">¿Olvidaste tu contraseña? Contacta a un administrador.</small>
        </div>

        <button type="submit" class="btn btn-primary w-100 btn-lg">
            <i class="fas fa-sign-in-alt me-2"></i>Ingresar
        </button>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

