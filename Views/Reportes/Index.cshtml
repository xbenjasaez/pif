                                <small>días</small>
                            </div>
                            <i class="fas fa-calendar-day fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Destacados -->
        <div class="row mb-4">
            <div class="col-12">
                <h5 class="mb-3"><i class="fas fa-star me-2 text-warning"></i>Destacados del Periodo</h5>
            </div>

            @if (Model.LibroMasSolicitado != null)
            {
                <div class="col-md-4 mb-3">
                    <div class="card border-primary h-100">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0"><i class="fas fa-crown me-1"></i>Libro Más Solicitado</h6>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-primary">@Model.LibroMasSolicitado.Titulo</h5>
                            <p class="text-muted mb-2">@Model.LibroMasSolicitado.Autor</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary fs-6">@Model.LibroMasSolicitado.TotalPrestamos préstamos</span>
                                <span class="badge bg-secondary">@Model.LibroMasSolicitado.Categoria</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.CategoriaMasPopular != null)
            {
                <div class="col-md-4 mb-3">
                    <div class="card border-success h-100">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0"><i class="fas fa-bookmark me-1"></i>Categoría Más Popular</h6>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-success">@Model.CategoriaMasPopular.Categoria</h5>
                            <p class="text-muted mb-2">Representa el @Model.CategoriaMasPopular.Porcentaje% de préstamos</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-success fs-6">@Model.CategoriaMasPopular.TotalPrestamos préstamos</span>
                                <span class="badge bg-warning text-dark">@Model.CategoriaMasPopular.PrestamosActivos activos</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.UsuarioMasMoroso != null && Model.UsuarioMasMoroso.PrestamosVencidos > 0)
            {
                <div class="col-md-4 mb-3">
                    <div class="card border-danger h-100">
                        <div class="card-header bg-danger text-white">
                            <h6 class="mb-0"><i class="fas fa-exclamation-triangle me-1"></i>Usuario con Más Atrasos</h6>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-danger">@Model.UsuarioMasMoroso.NombreCompleto</h5>
                            <p class="text-muted mb-2">RUT: @Model.UsuarioMasMoroso.RUT</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-danger fs-6">@Model.UsuarioMasMoroso.PrestamosVencidos vencidos</span>
                                <span class="badge bg-secondary">@Model.UsuarioMasMoroso.TotalPrestamos total</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Análisis Comparativo -->
        <div class="row mb-4">
            <div class="col-12">
                <h5 class="mb-3"><i class="fas fa-balance-scale me-2 text-secondary"></i>Análisis Comparativo</h5>
            </div>

            <div class="col-md-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-chart-pie me-1"></i>Distribución de Estados</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.TotalPrestamos > 0)
                        {
                            var porcentajeActivos = Math.Round((Model.PrestamosActivos * 100.0) / Model.TotalPrestamos, 1);
                            var porcentajeDevueltos = Math.Round((Model.TotalDevueltos * 100.0) / Model.TotalPrestamos, 1);
                            
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span><i class="fas fa-circle text-warning me-1"></i>Préstamos Activos</span>
                                    <strong>@Model.PrestamosActivos (@porcentajeActivos%)</strong>
                                </div>
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar bg-warning" style="width: @porcentajeActivos%">
                                        @porcentajeActivos%
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span><i class="fas fa-circle text-success me-1"></i>Préstamos Devueltos</span>
                                    <strong>@Model.TotalDevueltos (@porcentajeDevueltos%)</strong>
                                </div>
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar bg-success" style="width: @porcentajeDevueltos%">
                                        @porcentajeDevueltos%
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-info-circle me-1"></i>Recomendaciones</h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            @if (Model.IndiceRotacion < 2)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-lightbulb text-warning me-2"></i>
                                    <strong>Bajo índice de rotación:</strong> Considera promocionar más los libros disponibles.
                                </li>
                            }
                            else if (Model.IndiceRotacion > 5)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    <strong>Excelente rotación:</strong> Los libros tienen alta demanda.
                                </li>
                            }
                            
                            @if (Model.PrestamosVencidos > 0)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                                    <strong>Préstamos vencidos:</strong> Realizar seguimiento inmediato a @Model.PrestamosVencidos usuario(s).
                                </li>
                            }
                            
                            @if (Model.TasaDevolucionTardia > 20)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-clock text-warning me-2"></i>
                                    <strong>Alta tasa de atraso:</strong> Considerar recordatorios automáticos antes del vencimiento.
                                </li>
                            }
                            else
                            {
                                <li class="mb-2">
                                    <i class="fas fa-thumbs-up text-success me-2"></i>
                                    <strong>Buena puntualidad:</strong> Los usuarios devuelven a tiempo mayormente.
                                </li>
                            }

                            @if (Model.CategoriaMasPopular != null)
                            {
                                <li class="mb-2">
                                    <i class="fas fa-bookmark text-info me-2"></i>
                                    <strong>Categoría destacada:</strong> "@Model.CategoriaMasPopular.Categoria" tiene alta demanda. Ampliar colección.
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tendencias Mensuales -->
        @if (Model.EstadisticasMensuales.Any())
        {
            <div class="row mb-4">
                <div class="col-12">
                    <h5 class="mb-3"><i class="fas fa-chart-line me-2 text-primary"></i>Tendencias Mensuales</h5>
                </div>
                <div class="col-12">
                    <div class="card shadow">
                        <div class="card-header py-3 bg-gradient" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                            <h5 class="m-0 font-weight-bold">
                                <i class="fas fa-chart-line me-2"></i>Evolución Mensual de Préstamos y Devoluciones
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th><i class="fas fa-calendar me-1"></i>Mes</th>
                                            <th><i class="fas fa-calendar-alt me-1"></i>Año</th>
                                            <th><i class="fas fa-user-graduate me-1"></i>Segmento</th>
                                            <th class="text-center"><i class="fas fa-hand-holding me-1 text-primary"></i>Total Préstamos</th>
                                            <th class="text-center"><i class="fas fa-check-circle me-1 text-success"></i>Total Devoluciones</th>
                                            <th class="text-center"><i class="fas fa-chart-bar me-1"></i>Tasa</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var stat in Model.EstadisticasMensuales)
                                        {
                                            var tasaDevolucion = stat.TotalPrestamos > 0 
                                                ? Math.Round((stat.TotalDevoluciones * 100.0) / stat.TotalPrestamos, 1) 
                                                : 0;
                                            var colorClass = tasaDevolucion >= 80 ? "text-success" : tasaDevolucion >= 50 ? "text-warning" : "text-danger";
                                            
                                            <tr>
                                                <td><strong>@stat.Mes</strong></td>
                                                <td>@stat.Año</td>
                                                <td>@(stat.Segmento ?? "Global")</td>
                                                <td class="text-center">
                                                    <span class="badge bg-primary">@stat.TotalPrestamos</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-success">@stat.TotalDevoluciones</span>
                                                </td>
                                                <td class="text-center">
                                                    <strong class="@colorClass">@tasaDevolucion%</strong>
                                                    <div class="progress mt-1" style="height: 8px;">
                                                        <div class="progress-bar @(tasaDevolucion >= 80 ? "bg-success" : tasaDevolucion >= 50 ? "bg-warning" : "bg-danger")" 
                                                             style="width: @tasaDevolucion%"></div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
    <!-- FIN PESTAÑA 4 -->

</div>
<!-- FIN CONTENIDO DE PESTAÑAS -->

<!-- Información adicional -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm bg-light">
            <div class="card-body text-center py-3">
                <small class="text-muted">
                    <i class="fas fa-sync-alt me-1"></i>
                    Los datos se actualizan en tiempo real según el periodo seleccionado
                </small>
            </div>
        </div>
    </div>
</div>

<!-- Modal Exportar PDF -->
<div class="modal fade" id="exportarModal" tabindex="-1" aria-labelledby="exportarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="ExportarPdf" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="exportarModalLabel">
                        <i class="fas fa-file-pdf me-2 text-danger"></i>Exportar reportes a PDF
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="periodo" value="@Model.Filtro.Periodo" />
                    @if (Model.Filtro.Periodo == "Personalizado")
                    {
                        <input type="hidden" name="fechaInicio" value="@Model.Filtro.FechaInicio.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="fechaFin" value="@Model.Filtro.FechaFin.ToString("yyyy-MM-dd")" />
                    }
                    <input type="hidden" name="curso" value="@Model.Filtro.CursoSeleccionado" />
                    <input type="hidden" name="categoria" value="@Model.Filtro.CategoriaSeleccionada" />

                    <p class="text-muted small mb-3">
                        Selecciona las secciones que quieras incluir en el PDF. Se usará el periodo actualmente aplicado.
                    </p>

                    <div class="list-group">
                        <label class="list-group-item d-flex align-items-center gap-2">
                            <input asp-for="ExportOptions.IncluirResumen" class="form-check-input me-2" />
                            <span>Resumen ejecutivo</span>
                        </label>
                        <label class="list-group-item d-flex align-items-center gap-2">
                            <input asp-for="ExportOptions.IncluirPrestamos" class="form-check-input me-2" />
                            <span>Análisis de préstamos</span>
                        </label>
                        <label class="list-group-item d-flex align-items-center gap-2">
                            <input asp-for="ExportOptions.IncluirRankings" class="form-check-input me-2" />
                            <span>Rankings y popularidad</span>
                        </label>
                        <label class="list-group-item d-flex align-items-center gap-2">
                            <input asp-for="ExportOptions.IncluirEstadisticas" class="form-check-input me-2" />
                            <span>Estadísticas avanzadas</span>
                        </label>
                        <label class="list-group-item d-flex align-items-center gap-2">
                            <input asp-for="ExportOptions.IncluirAlertas" class="form-check-input me-2" />
                            <span>Alertas rápidas / hallazgos</span>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-file-download me-1"></i>Descargar PDF
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

