        <!-- Rankings -->
        <div class="row">
    <!-- Top Usuarios -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow">
            <div class="card-header py-3 bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h5 class="m-0 font-weight-bold">
                    <i class="fas fa-trophy me-2"></i>Top 10 Usuarios Más Activos
                </h5>
            </div>
            <div class="card-body">
                @if (Model.TopUsuarios != null && Model.TopUsuarios.Any())
                {
                    var rank = 1;
                    var maxPrestamos = Model.TopUsuarios.Max(u => u.TotalPrestamos);
                    
                    @foreach (var usuario in Model.TopUsuarios)
                    {
                        var porcentaje = maxPrestamos > 0 ? (usuario.TotalPrestamos * 100.0 / maxPrestamos) : 0;
                        var rankClass = rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "";
                        
                        <div class="ranking-card card mb-3 @rankClass" style="border: none;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        @if (rank == 1)
                                        {
                                            <span class="medal">🥇</span>
                                        }
                                        else if (rank == 2)
                                        {
                                            <span class="medal">🥈</span>
                                        }
                                        else if (rank == 3)
                                        {
                                            <span class="medal">🥉</span>
                                        }
                                        else
                                        {
                                            <span class="ranking-number">#@rank</span>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">
                                            <strong>@usuario.NombreCompleto</strong>
                                            @if (rank <= 3)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">Top @rank</span>
                                            }
                                        </h6>
                                        <p class="mb-2 text-muted small">
                                            <i class="fas fa-id-card me-1"></i>@usuario.RUT
                                        </p>
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="progress flex-grow-1 me-2" style="height: 20px;">
                                                <div class="progress-bar-custom" role="progressbar" style="width: @porcentaje%" aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                                                    @usuario.TotalPrestamos préstamos
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-3 flex-wrap">
                                            <small class="text-muted">
                                                <i class="fas fa-check-circle text-success me-1"></i>
                                                @usuario.PrestamosDevueltos devueltos
                                            </small>
                                            <small class="text-muted">
                                                <i class="fas fa-clock text-warning me-1"></i>
                                                @usuario.PrestamosActivos activos
                                            </small>
                                            @if (usuario.PrestamosVencidos > 0)
                                            {
                                                <small class="text-muted">
                                                    <i class="fas fa-exclamation-triangle text-danger me-1"></i>
                                                    @usuario.PrestamosVencidos vencidos
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        rank++;
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        No hay datos de préstamos disponibles en el periodo seleccionado.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top Libros -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow">
            <div class="card-header py-3 bg-gradient" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                <h5 class="m-0 font-weight-bold">
                    <i class="fas fa-star me-2"></i>Top 10 Libros Más Populares
                </h5>
            </div>
            <div class="card-body">
                @if (Model.TopLibros != null && Model.TopLibros.Any())
                {
                    var rank = 1;
                    var maxPrestamos = Model.TopLibros.Max(l => l.TotalPrestamos);
                    
                    @foreach (var libro in Model.TopLibros)
                    {
                        var porcentaje = maxPrestamos > 0 ? (libro.TotalPrestamos * 100.0 / maxPrestamos) : 0;
                        var rankClass = rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "";
                        
                        <div class="ranking-card card mb-3 @rankClass" style="border: none;">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        @if (rank == 1)
                                        {
                                            <span class="medal">🥇</span>
                                        }
                                        else if (rank == 2)
                                        {
                                            <span class="medal">🥈</span>
                                        }
                                        else if (rank == 3)
                                        {
                                            <span class="medal">🥉</span>
                                        }
                                        else
                                        {
                                            <span class="ranking-number">#@rank</span>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
