</div>

<!-- Análisis por curso -->
<div class="row mb-4">
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="card shadow h-100">
            <div class="card-header py-3 bg-gradient" style="background: linear-gradient(135deg, #4158D0 0%, #C850C0 50%, #FFCC70 100%); color: white;">
                <h5 class="m-0 font-weight-bold">
                    <i class="fas fa-users me-2"></i>Cursos que más solicitan libros
                </h5>
            </div>
            <div class="card-body">
                @if (Model.CursosTop.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Curso</th>
                                    <th>Total</th>
                                    <th>%</th>
                                    <th>Activos</th>
                                    <th>Vencidos</th>
                                    <th>Promedio días</th>
                                    <th>Libros más pedidos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var curso in Model.CursosTop)
                                {
                                    <tr>
                                        <td><strong>@curso.Curso</strong></td>
                                        <td>@curso.TotalPrestamos</td>
                                        <td>@curso.PorcentajeDelTotal%</td>
                                        <td>
                                            <span class="badge bg-success">@curso.PrestamosActivos</span>
                                        </td>
                                        <td>
                                            <span class="badge @(curso.PrestamosVencidos > 0 ? "bg-danger" : "bg-secondary")">
                                                @curso.PrestamosVencidos
                                            </span>
                                        </td>
                                        <td>@curso.PromedioDiasPrestamo</td>
                                        <td>
                                            @if (curso.LibrosFavoritos.Any())
                                            {
                                                foreach (var libro in curso.LibrosFavoritos)
                                                {
                                                    <span class="badge bg-primary text-wrap me-1 mb-1">
                                                        @libro.LibroTitulo (@libro.TotalPrestamos)
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin datos</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Aún no hay préstamos asociados a cursos registrados en el periodo seleccionado.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="text-muted text-uppercase mb-3">Indicadores por curso</h6>
                <p class="mb-2">
                    <i class="fas fa-school text-primary me-2"></i>
                    <strong>@Model.TotalCursosConPrestamos</strong> curso(s) registraron préstamos.
                </p>
                @if (Model.CursoMasActivo != null)
                {
                    <p class="mb-2">
                        <i class="fas fa-trophy text-warning me-2"></i>
                        <strong>@Model.CursoMasActivo.Curso</strong> es el curso más activo (@Model.CursoMasActivo.TotalPrestamos prestamos).
                    </p>
                }
                @if (Model.CursoMayorMora != null && Model.CursoMayorMora.PrestamosVencidos > 0)
                {
                    <p class="mb-0">
                        <i class="fas fa-exclamation-circle text-danger me-2"></i>
                        El curso con más morosidad es <strong>@Model.CursoMayorMora.Curso</strong> (@Model.CursoMayorMora.PrestamosVencidos vencidos).
                    </p>
                }
            </div>
        </div>
        @if (Model.CursosConRiesgo.Any())
        {
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0"><i class="fas fa-calendar-times me-2"></i>Cursos con más vencidos</h6>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var curso in Model.CursosConRiesgo)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@curso.Curso</span>
                                <span class="badge bg-danger">@curso.PrestamosVencidos</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body text-center text-muted">
                    <i class="fas fa-check-circle text-success mb-2"></i>
                    <p class="mb-0">No hay cursos con vencidos en el periodo.</p>
                </div>
            </div>
        }
    </div>
</div>

    </div>
    <!-- FIN PESTAÑA 2 -->

    <!-- PESTAÑA 3: RANKINGS -->
    <div class="tab-pane fade" id="rankings" role="tabpanel">
        
        <h4 class="mb-4"><i class="fas fa-trophy me-2"></i>Rankings y Popularidad</h4>

<!-- Categorías Más Populares -->
@if (Model.CategoriasPopulares.Any())
{
    <div class="row mb-4">
