            <div class="card-header py-3 bg-gradient" style="background: linear-gradient(135deg, #ee0979 0%, #ff6a00 100%); color: white;">
                <h5 class="m-0 font-weight-bold">
                    <i class="fas fa-exclamation-triangle me-2"></i>Estado de Préstamos
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
