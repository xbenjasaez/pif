                @if (Model.TotalDevueltos > 0)
                {
                    <div class="row text-center mb-4">
                        <div class="col-6">
                            <div class="p-3 bg-success bg-opacity-10 rounded">
                                <i class="fas fa-check-circle fa-3x text-success mb-2"></i>
                                <h3 class="mb-0 text-success">@Model.TasaDevolucionPuntual%</h3>
                                <p class="mb-0 text-muted small">A Tiempo</p>
                                <small class="text-muted">(@Model.TotalDevolucionesPuntuales libros)</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-danger bg-opacity-10 rounded">
                                <i class="fas fa-exclamation-circle fa-3x text-danger mb-2"></i>
                                <h3 class="mb-0 text-danger">@Model.TasaDevolucionTardia%</h3>
                                <p class="mb-0 text-muted small">Tardías</p>
                                <small class="text-muted">(@Model.TotalDevolucionesTardias libros)</small>
                            </div>
                        </div>
                    </div>
                    <div class="progress" style="height: 30px;">
                        <div class="progress-bar bg-success" role="progressbar" 
                             style="width: @Model.TasaDevolucionPuntual%" 
                             aria-valuenow="@Model.TasaDevolucionPuntual" aria-valuemin="0" aria-valuemax="100">
                            @Model.TasaDevolucionPuntual% Puntuales
                        </div>
                        <div class="progress-bar bg-danger" role="progressbar" 
                             style="width: @Model.TasaDevolucionTardia%" 
                             aria-valuenow="@Model.TasaDevolucionTardia" aria-valuemin="0" aria-valuemax="100">
                            @Model.TasaDevolucionTardia% Tardías
                        </div>
                    </div>
                    <p class="text-center text-muted mt-3 mb-0">
                        Total de libros devueltos: <strong>@Model.TotalDevueltos</strong>
                    </p>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        No hay datos de devoluciones en el periodo seleccionado.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Libros No Devueltos y Vencidos -->
    <div class="col-lg-6 mb-4">
