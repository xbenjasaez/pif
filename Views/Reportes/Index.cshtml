                {
                    <div class="alert alert-info mb-0 mt-3">
                        <i class="fas fa-clock me-2"></i>
                        <strong>Tiempo Promedio de Préstamo:</strong> 
                        @Model.PromedioTiempoPrestamoEnDias días
