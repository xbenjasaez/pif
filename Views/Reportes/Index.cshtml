        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #ff9966 0%, #ff5e62 100%); color: white;">
                <h6 class="mb-0"><i class="fas fa-layer-group me-2"></i>Distribución por categoría</h6>
            </div>
            <div class="card-body">
                @if (Model.ChartData?.CategoriasLabels?.Any() == true)
