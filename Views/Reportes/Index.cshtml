                                                <div class="progress-bar-custom" role="progressbar" style="width: @porcentaje%" aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                                                    @libro.TotalPrestamos préstamos
                                                </div>
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            <i class="fas fa-clock text-warning me-1"></i>
