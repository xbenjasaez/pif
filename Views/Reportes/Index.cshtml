                           class="text-decoration-none" style="cursor: pointer;">
                            <div class="p-4 bg-danger bg-opacity-10 rounded h-100 hover-lift">
                                <i class="fas fa-calendar-times fa-3x text-danger mb-3"></i>
                                <h2 class="mb-0 text-danger">@Model.PrestamosVencidos</h2>
                                <p class="mb-0 text-muted">Préstamos Vencidos</p>
                                <small class="text-muted">(Requieren atención)</small>
                                <div class="mt-2">
                                    <i class="fas fa-eye me-1"></i>
                                    <small class="text-primary">Click para ver detalle</small>
                                </div>
                            </div>
