@model List<BibliotecaVirtualWeb.Models.PrestamoActivoViewModel>
@{
    ViewData["Title"] = "Libros No Devueltos - Reportes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-warning">
        <i class="fas fa-book-open me-2"></i>Libros No Devueltos
    </h1>
    <a asp-action="Index" asp-route-periodo="@ViewBag.Periodo" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver a Reportes
    </a>
</div>

<!-- Información del Filtro -->
<div class="alert alert-info mb-4">
    <i class="fas fa-info-circle me-2"></i>
    Mostrando préstamos activos desde <strong>@ViewBag.FechaInicio.ToString("dd/MM/yyyy")</strong> 
    hasta <strong>@ViewBag.FechaFin.ToString("dd/MM/yyyy")</strong>
    <br>
    <strong>Total de préstamos activos:</strong> @ViewBag.TotalActivos &nbsp;|&nbsp;
    <strong class="text-danger">Vencidos:</strong> @ViewBag.TotalVencidos
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow">
        <div class="card-header py-3 bg-warning text-dark">
            <h5 class="m-0 font-weight-bold">
                <i class="fas fa-list me-2"></i>Detalle de Préstamos Activos
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-book me-1"></i>Libro</th>
                            <th><i class="fas fa-barcode me-1"></i>Ejemplar</th>
                            <th><i class="fas fa-user me-1"></i>Usuario</th>
                            <th><i class="fas fa-calendar-plus me-1"></i>Fecha Préstamo</th>
                            <th><i class="fas fa-calendar-check me-1"></i>Fecha Vencimiento</th>
                            <th><i class="fas fa-hourglass-half me-1"></i>Días</th>
                            <th><i class="fas fa-traffic-light me-1"></i>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prestamo in Model)
                        {
                            var filaClass = prestamo.EstaVencido ? "table-danger" : "";
                            var estadoBadge = prestamo.EstaVencido ? "badge bg-danger" : "badge bg-success";
                            var estadoTexto = prestamo.EstaVencido ? $"Vencido ({prestamo.DiasTranscurridos - (prestamo.FechaVencimiento - prestamo.FechaPrestamo).Days} días atraso)" : "Vigente";
                            
                            <tr class="@filaClass">
                                <td>
                                    <strong>@prestamo.LibroTitulo</strong>
                                    <br>
                                    <small class="text-muted">@prestamo.LibroAutor</small>
                                </td>
                                <td>
                                    <code>@prestamo.EjemplarCodigo</code>
                                </td>
                                <td>
                                    <strong>@prestamo.UsuarioNombre</strong>
                                    <br>
                                    <small class="text-muted">@prestamo.UsuarioRUT</small>
                                </td>
                                <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                <td>@prestamo.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-info">@prestamo.DiasTranscurridos días</span>
                                </td>
                                <td>
                                    <span class="@estadoBadge">
                                        @if (prestamo.EstaVencido)
                                        {
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-check-circle me-1"></i>
                                        }
                                        @estadoTexto
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <div class="row">
                <div class="col-md-4">
                    <div class="text-center p-2 bg-light rounded">
                        <i class="fas fa-book text-primary fa-2x mb-2"></i>
                        <h5 class="mb-0">@ViewBag.TotalActivos</h5>
                        <small class="text-muted">Total Activos</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center p-2 bg-light rounded">
                        <i class="fas fa-exclamation-triangle text-danger fa-2x mb-2"></i>
                        <h5 class="mb-0">@ViewBag.TotalVencidos</h5>
                        <small class="text-muted">Vencidos</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center p-2 bg-light rounded">
                        <i class="fas fa-check-circle text-success fa-2x mb-2"></i>
                        <h5 class="mb-0">@(ViewBag.TotalActivos - ViewBag.TotalVencidos)</h5>
                        <small class="text-muted">Vigentes</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle me-2"></i>
        <strong>¡Excelente!</strong> No hay libros sin devolver en el periodo seleccionado.
    </div>
}

