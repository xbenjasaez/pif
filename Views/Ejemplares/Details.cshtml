@model BibliotecaVirtualWeb.Models.Ejemplar
@{
    ViewData["Title"] = "Detalle del Ejemplar";
    var historial = ViewBag.HistorialPrestamos as List<BibliotecaVirtualWeb.Models.Prestamo> ?? new List<BibliotecaVirtualWeb.Models.Prestamo>();
    var estadisticas = ViewBag.Estadisticas as BibliotecaVirtualWeb.Models.EjemplarEstadisticasViewModel ?? new BibliotecaVirtualWeb.Models.EjemplarEstadisticasViewModel();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary">
        <i class="fas fa-copy me-2"></i>Detalle del Ejemplar
    </h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit me-1"></i>Editar
        </a>
        <a asp-action="Index" asp-route-libroId="@Model.LibroId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

@if (Model.Estado == "Deteriorado")
{
    <div class="alert alert-warning border-warning border-3 mb-4">
        <div class="d-flex align-items-start">
            <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
            <div>
                <h5 class="alert-heading mb-1">Ejemplar en mal estado</h5>
                <p class="mb-0">
                    @if (!string.IsNullOrEmpty(Model.Notas))
                    {
                        @Model.Notas
                    }
                    else
                    {
                        <span>Este ejemplar está marcado como deteriorado.</span>
                    }
                </p>
            </div>
        </div>
    </div>
}

<div class="row">
    <!-- Información principal -->
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-info-circle me-2"></i>Información del Ejemplar
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl>
                            <dt class="text-muted small">Código de Barras</dt>
                            <dd class="h5">
                                <i class="fas fa-barcode me-2 text-primary"></i>
                                <strong>@Model.CodigoBarras</strong>
                            </dd>

                            <dt class="text-muted small mt-3">Estado</dt>
                            <dd>
                                <span class="@Model.EstadoBadgeClass fs-6">@Model.Estado</span>
                            </dd>

                            <dt class="text-muted small mt-3">Fecha de Agregado</dt>
                            <dd>
                                <i class="fas fa-calendar-plus me-1 text-muted"></i>
                                @Model.FechaAgregado.ToString("dd/MM/yyyy HH:mm")
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl>
                            <dt class="text-muted small">Ubicación</dt>
                            <dd class="h5">
                                @if (!string.IsNullOrEmpty(Model.Ubicacion))
                                {
                                    <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                                    <strong>@Model.Ubicacion</strong>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">
                                        <i class="fas fa-question-circle me-1"></i>Sin ubicación asignada
                                    </span>
                                }
                            </dd>

                            @if (Model.EstaPrestado && !string.IsNullOrEmpty(Model.PrestadoA))
                            {
                                <dt class="text-muted small mt-3">Prestado a</dt>
                                <dd>
                                    <i class="fas fa-user me-1 text-danger"></i>
                                    <strong class="text-danger">@Model.PrestadoA</strong>
                                </dd>

                                <dt class="text-muted small mt-3">Fecha de Préstamo</dt>
                                <dd>
                                    <i class="fas fa-calendar-check me-1 text-muted"></i>
                                    @Model.FechaPrestamo?.ToString("dd/MM/yyyy HH:mm")
                                </dd>
                            }
                        </dl>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notas) && Model.Estado != "Deteriorado")
                {
                    <hr />
                    <dl>
                        <dt class="text-muted small">Notas</dt>
                        <dd class="bg-light p-3 rounded">
                            <i class="fas fa-sticky-note me-2 text-warning"></i>
                            @Model.Notas
                        </dd>
                    </dl>
                }
            </div>
        </div>

        <!-- Estadísticas del ejemplar -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-success">
                    <i class="fas fa-chart-pie me-2"></i>Estadísticas de Circulación
                </h6>
            </div>
            <div class="card-body">
                @if (estadisticas.TotalPrestamos > 0)
                {
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 bg-primary bg-opacity-10 rounded">
                                <div class="h3 mb-0 text-primary">@estadisticas.TotalPrestamos</div>
                                <small class="text-muted">Total préstamos</small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 bg-info bg-opacity-10 rounded">
                                <div class="h3 mb-0 text-info">@estadisticas.UsuariosUnicos</div>
                                <small class="text-muted">Usuarios únicos</small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 bg-success bg-opacity-10 rounded">
                                <div class="h3 mb-0 text-success">@estadisticas.PorcentajeATiempo%</div>
                                <small class="text-muted">Devueltos a tiempo</small>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center p-3 bg-secondary bg-opacity-10 rounded">
                                <div class="h3 mb-0">@estadisticas.PromedioDiasPrestamo</div>
                                <small class="text-muted">Días promedio</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Devoluciones a tiempo</span>
                                <span class="badge bg-success">@estadisticas.DevolucionesATiempo</span>
                            </div>
                            <div class="progress mb-3" style="height: 8px;">
                                @{
                                    var totalDevoluciones = estadisticas.DevolucionesATiempo + estadisticas.DevolucionesTardias;
                                    var porcentajeATiempo = totalDevoluciones > 0 ? (estadisticas.DevolucionesATiempo * 100 / totalDevoluciones) : 100;
                                }
                                <div class="progress-bar bg-success" style="width: @porcentajeATiempo%"></div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Devoluciones tardías</span>
                                <span class="badge bg-danger">@estadisticas.DevolucionesTardias</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                @{
                                    var porcentajeTardias = totalDevoluciones > 0 ? (estadisticas.DevolucionesTardias * 100 / totalDevoluciones) : 0;
                                }
                                <div class="progress-bar bg-danger" style="width: @porcentajeTardias%"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <dl class="small">
                                @if (estadisticas.UltimoPrestamo.HasValue)
                                {
                                    <dt class="text-muted">Último préstamo</dt>
                                    <dd>
                                        <i class="fas fa-calendar me-1"></i>
                                        @estadisticas.UltimoPrestamo.Value.ToString("dd/MM/yyyy")
                                    </dd>
                                }
                                @if (estadisticas.UltimaDevolucion.HasValue)
                                {
                                    <dt class="text-muted">Última devolución</dt>
                                    <dd>
                                        <i class="fas fa-calendar-check me-1"></i>
                                        @estadisticas.UltimaDevolucion.Value.ToString("dd/MM/yyyy")
                                    </dd>
                                }
                                @if (estadisticas.PrestamosActivos > 0)
                                {
                                    <dt class="text-muted">Préstamos activos</dt>
                                    <dd>
                                        <span class="badge bg-warning text-dark">@estadisticas.PrestamosActivos activo(s)</span>
                                    </dd>
                                }
                            </dl>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-chart-bar fa-3x mb-2"></i>
                        <p class="mb-0">Este ejemplar aún no tiene historial de préstamos.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Historial de préstamos -->
        <div class="card shadow">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-info">
                    <i class="fas fa-history me-2"></i>Historial de Préstamos
                </h6>
                <span class="badge bg-info">@historial.Count registro(s)</span>
            </div>
            <div class="card-body p-0">
                @if (historial.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Usuario</th>
                                    <th>Fecha Préstamo</th>
                                    <th>Vencimiento</th>
                                    <th>Devolución</th>
                                    <th>Estado</th>
                                    <th>Duración</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prestamo in historial)
                                {
                                    var esVencido = prestamo.Estado == "Activo" && prestamo.FechaVencimiento < DateTime.Now;
                                    var fueDevueltoTarde = prestamo.FechaDevolucion.HasValue && prestamo.FechaDevolucion > prestamo.FechaVencimiento;
                                    <tr class="@(esVencido ? "table-danger" : fueDevueltoTarde ? "table-warning" : "")">
                                        <td>
                                            @if (prestamo.Usuario != null)
                                            {
                                                <a asp-controller="Usuarios" asp-action="Details" asp-route-id="@prestamo.UsuarioId" class="text-decoration-none">
                                                    <strong>@prestamo.Usuario.NombreCompleto</strong>
                                                </a>
                                                <br />
                                                <small class="text-muted">
                                                    @prestamo.Usuario.RUT
                                                    @if (!string.IsNullOrEmpty(prestamo.Usuario.Curso))
                                                    {
                                                        <span class="badge bg-light text-dark ms-1">@prestamo.Usuario.CursoConLetra</span>
                                                    }
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Usuario eliminado</span>
                                            }
                                        </td>
                                        <td>
                                            <i class="fas fa-calendar-plus me-1 text-muted"></i>
                                            @prestamo.FechaPrestamo.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            @if (esVencido)
                                            {
                                                <span class="text-danger fw-bold">
                                                    <i class="fas fa-exclamation-circle me-1"></i>
                                                    @prestamo.FechaVencimiento.ToString("dd/MM/yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                @prestamo.FechaVencimiento.ToString("dd/MM/yyyy")
                                            }
                                        </td>
                                        <td>
                                            @if (prestamo.FechaDevolucion.HasValue)
                                            {
                                                <i class="fas fa-calendar-check me-1 @(fueDevueltoTarde ? "text-warning" : "text-success")"></i>
                                                @prestamo.FechaDevolucion.Value.ToString("dd/MM/yyyy")
                                                @if (fueDevueltoTarde)
                                                {
                                                    <br />
                                                    <small class="text-warning">
                                                        <i class="fas fa-clock me-1"></i>
                                                        @((int)(prestamo.FechaDevolucion.Value - prestamo.FechaVencimiento).TotalDays) días tarde
                                                    </small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="@prestamo.EstadoBadgeClass">@prestamo.Estado</span>
                                        </td>
                                        <td>
                                            @if (prestamo.FechaDevolucion.HasValue)
                                            {
                                                var dias = (int)(prestamo.FechaDevolucion.Value - prestamo.FechaPrestamo).TotalDays;
                                                <span class="badge bg-light text-dark">@dias días</span>
                                            }
                                            else if (prestamo.Estado == "Activo")
                                            {
                                                var diasActivo = (int)(DateTime.Now - prestamo.FechaPrestamo).TotalDays;
                                                <span class="badge bg-info">@diasActivo días</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-inbox fa-3x mb-3"></i>
                        <h5>Sin historial de préstamos</h5>
                        <p class="mb-0">Este ejemplar no ha sido prestado aún.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Información del libro -->
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-success">
                    <i class="fas fa-book me-2"></i>Libro Asociado
                </h6>
            </div>
            <div class="card-body">
                @if (Model.Libro != null)
                {
                    <h5 class="card-title">@Model.Libro.Titulo</h5>
                    <p class="card-text text-muted">@Model.Libro.Autor</p>
                    
                    <dl class="small">
                        @if (!string.IsNullOrEmpty(Model.Libro.ISBN))
                        {
                            <dt>ISBN</dt>
                            <dd>@Model.Libro.ISBN</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Libro.Editorial))
                        {
                            <dt>Editorial</dt>
                            <dd>@Model.Libro.Editorial</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Libro.Categoria))
                        {
                            <dt>Categoría</dt>
                            <dd><span class="badge bg-secondary">@Model.Libro.Categoria</span></dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Libro.Ubicacion))
                        {
                            <dt>Ubicación del libro</dt>
                            <dd>
                                <i class="fas fa-map-marker-alt me-1 text-primary"></i>
                                @Model.Libro.Ubicacion
                            </dd>
                        }
                    </dl>

                    <a asp-controller="Libros" asp-action="Details" asp-route-id="@Model.LibroId" class="btn btn-outline-success btn-sm w-100">
                        <i class="fas fa-eye me-1"></i>Ver Libro Completo
                    </a>
                }
                else
                {
                    <p class="text-muted">Libro no disponible</p>
                }
            </div>
        </div>

        <!-- Código de barras visual -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-dark">
                    <i class="fas fa-barcode me-2"></i>Código de Barras
                </h6>
            </div>
            <div class="card-body text-center">
                <svg id="barcode-svg"></svg>
                <p class="small text-muted mt-2 mb-0">@Model.CodigoBarras</p>
                <form asp-action="ImprimirSeleccionados" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="seleccionados" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-print me-1"></i>Imprimir código
                    </button>
                </form>
            </div>
        </div>

        <!-- Acciones rápidas -->
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-bolt me-2"></i>Acciones Rápidas
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (Model.Estado == "Disponible" || Model.Estado == "Deteriorado")
                    {
                        <a asp-controller="Prestamos" asp-action="PrestamoRapido" class="btn btn-success">
                            <i class="fas fa-hand-holding me-1"></i>Prestar este ejemplar
                        </a>
                    }
                    else if (Model.Estado == "Prestado")
                    {
                        <a asp-controller="Prestamos" asp-action="DevolucionRapida" class="btn btn-warning">
                            <i class="fas fa-undo me-1"></i>Registrar devolución
                        </a>
                    }
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="fas fa-edit me-1"></i>Editar ejemplar
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="fas fa-trash me-1"></i>Eliminar ejemplar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const codigoBarras = "@Model.CodigoBarras";
            if (codigoBarras && codigoBarras.length === 13) {
                try {
                    JsBarcode("#barcode-svg", codigoBarras, {
                        format: "EAN13",
                        width: 2,
                        height: 60,
                        displayValue: false,
                        margin: 10
                    });
                } catch (e) {
                    console.error("Error generando código de barras:", e);
                    document.getElementById("barcode-svg").innerHTML = '<text>Error al generar</text>';
                }
            }
        });
    </script>
}
