@model BibliotecaVirtualWeb.Models.Ejemplar
@{
    ViewData["Title"] = "Detalle del Ejemplar";
    var historial = ViewBag.HistorialPrestamos as List<BibliotecaVirtualWeb.Models.Prestamo> ?? new List<BibliotecaVirtualWeb.Models.Prestamo>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary">
        <i class="fas fa-copy me-2"></i>Detalle del Ejemplar
    </h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit me-1"></i>Editar
        </a>
        <a asp-action="Index" asp-route-libroId="@Model.LibroId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<div class="row">
    <!-- Información principal -->
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-info-circle me-2"></i>Información del Ejemplar
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl>
                            <dt class="text-muted small">Código de Barras</dt>
                            <dd class="h5">
                                <i class="fas fa-barcode me-2 text-primary"></i>
                                <strong>@Model.CodigoBarras</strong>
                            </dd>

                            <dt class="text-muted small mt-3">Estado</dt>
                            <dd>
                                <span class="@Model.EstadoBadgeClass fs-6">@Model.Estado</span>
                            </dd>

                            <dt class="text-muted small mt-3">Fecha de Agregado</dt>
                            <dd>
                                <i class="fas fa-calendar-plus me-1 text-muted"></i>
                                @Model.FechaAgregado.ToString("dd/MM/yyyy HH:mm")
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl>
                            <dt class="text-muted small">Ubicación</dt>
                            <dd class="h5">
                                @if (!string.IsNullOrEmpty(Model.Ubicacion))
                                {
                                    <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                                    <strong>@Model.Ubicacion</strong>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">
                                        <i class="fas fa-question-circle me-1"></i>Sin ubicación asignada
                                    </span>
                                }
                            </dd>

                            @if (Model.EstaPrestado && !string.IsNullOrEmpty(Model.PrestadoA))
                            {
                                <dt class="text-muted small mt-3">Prestado a</dt>
                                <dd>
                                    <i class="fas fa-user me-1 text-danger"></i>
                                    <strong class="text-danger">@Model.PrestadoA</strong>
                                </dd>

                                <dt class="text-muted small mt-3">Fecha de Préstamo</dt>
                                <dd>
                                    <i class="fas fa-calendar-check me-1 text-muted"></i>
                                    @Model.FechaPrestamo?.ToString("dd/MM/yyyy HH:mm")
                                </dd>
                            }
                        </dl>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notas))
                {
                    <hr />
                    <dl>
                        <dt class="text-muted small">Notas</dt>
                        <dd class="bg-light p-3 rounded">
                            <i class="fas fa-sticky-note me-2 text-warning"></i>
                            @Model.Notas
                        </dd>
                    </dl>
                }
            </div>
        </div>

        <!-- Historial de préstamos -->
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-info">
                    <i class="fas fa-history me-2"></i>Historial de Préstamos (últimos 10)
                </h6>
            </div>
            <div class="card-body">
                @if (historial.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Fecha Préstamo</th>
                                    <th>Fecha Devolución</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prestamo in historial)
                                {
                                    <tr class="@(prestamo.Estado == "Activo" && prestamo.FechaVencimiento < DateTime.Now ? "table-danger" : "")">
                                        <td>
                                            @if (prestamo.Usuario != null)
                                            {
                                                <strong>@prestamo.Usuario.NombreCompleto</strong>
                                                <br />
                                                <small class="text-muted">@prestamo.Usuario.RUT</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Usuario eliminado</span>
                                            }
                                        </td>
                                        <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (prestamo.FechaDevolucion.HasValue)
                                            {
                                                @prestamo.FechaDevolucion.Value.ToString("dd/MM/yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-warning">Pendiente</span>
                                            }
                                        </td>
                                        <td><span class="@prestamo.EstadoBadgeClass">@prestamo.Estado</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p class="mb-0">Este ejemplar no tiene historial de préstamos.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Información del libro -->
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-success">
                    <i class="fas fa-book me-2"></i>Libro Asociado
                </h6>
            </div>
            <div class="card-body">
                @if (Model.Libro != null)
                {
                    <h5 class="card-title">@Model.Libro.Titulo</h5>
                    <p class="card-text text-muted">@Model.Libro.Autor</p>
                    
                    <dl class="small">
                        @if (!string.IsNullOrEmpty(Model.Libro.ISBN))
                        {
                            <dt>ISBN</dt>
                            <dd>@Model.Libro.ISBN</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Libro.Editorial))
                        {
                            <dt>Editorial</dt>
                            <dd>@Model.Libro.Editorial</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Libro.Categoria))
                        {
                            <dt>Categoría</dt>
                            <dd><span class="badge bg-secondary">@Model.Libro.Categoria</span></dd>
                        }
                    </dl>

                    <a asp-controller="Libros" asp-action="Details" asp-route-id="@Model.LibroId" class="btn btn-outline-success btn-sm w-100">
                        <i class="fas fa-eye me-1"></i>Ver Libro Completo
                    </a>
                }
                else
                {
                    <p class="text-muted">Libro no disponible</p>
                }
            </div>
        </div>

        <!-- Código de barras visual -->
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-dark">
                    <i class="fas fa-barcode me-2"></i>Código de Barras
                </h6>
            </div>
            <div class="card-body text-center">
                <svg id="barcode-svg"></svg>
                <p class="small text-muted mt-2 mb-0">@Model.CodigoBarras</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const codigoBarras = "@Model.CodigoBarras";
            if (codigoBarras && codigoBarras.length === 13) {
                try {
                    JsBarcode("#barcode-svg", codigoBarras, {
                        format: "EAN13",
                        width: 2,
                        height: 60,
                        displayValue: false,
                        margin: 10
                    });
                } catch (e) {
                    console.error("Error generando código de barras:", e);
                    document.getElementById("barcode-svg").innerHTML = '<text>Error al generar</text>';
                }
            }
        });
    </script>
}

