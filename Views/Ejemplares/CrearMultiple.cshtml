@{
    ViewData["Title"] = "Crear Múltiples Ejemplares";
    var libroId = ViewBag.LibroId as int?;
    var libroTitulo = ViewBag.LibroTitulo as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-layer-group me-2"></i>Crear Múltiples Ejemplares</h1>
    <a asp-action="Index" asp-route-libroId="@libroId" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        <div class="alert alert-info mb-4 d-flex flex-wrap align-items-center gap-3">
            <div>
                <i class="fas fa-book me-2"></i>
                <strong>Libro:</strong> @libroTitulo
            </div>
            @if (!string.IsNullOrWhiteSpace(ViewBag.LibroUbicacion as string))
            {
                <div class="badge bg-light text-muted border">
                    <i class="fas fa-map-marker-alt me-1 text-primary"></i>
                    Ubicación: @ViewBag.LibroUbicacion
                </div>
            }
            else
            {
                <div class="text-muted small">
                    <i class="fas fa-map-marker-alt me-1"></i>Sin ubicación asignada
                </div>
            }
        </div>

        <form asp-action="CrearMultiple" method="post">
            <input type="hidden" name="libroId" value="@libroId" />
            
            <div class="mb-3">
                <label for="cantidad" class="form-label">Cantidad de Ejemplares</label>
                <input type="number" name="cantidad" id="cantidad" class="form-control form-control-lg" min="1" max="100" value="1" required />
                <small class="form-text text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    Máximo 100 ejemplares a la vez. Se generarán códigos de barras únicos automáticamente.
                </small>
            </div>

            <div class="mb-3">
                <label for="ubicacion" class="form-label">Ubicación para los nuevos ejemplares</label>
                <input type="text"
                       name="ubicacion"
                       id="ubicacion"
                       class="form-control"
                       maxlength="100"
                       value="@(ViewBag.LibroUbicacion ?? "")"
                       placeholder="Ej: A-5" />
                <small class="form-text text-muted">
                    <i class="fas fa-map-marker-alt me-1"></i>
                    Se usa la ubicación del libro por defecto; puedes cambiarla para esta creación en lote.
                </small>
            </div>

            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Nota:</strong> Esta acción creará @libroTitulo ejemplares con códigos de barras únicos.
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" asp-route-libroId="@libroId" class="btn btn-secondary">
                    <i class="fas fa-times me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-layer-group me-1"></i>Crear Ejemplares
                </button>
            </div>
        </form>
    </div>
</div>

