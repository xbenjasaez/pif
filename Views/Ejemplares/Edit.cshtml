@model BibliotecaVirtualWeb.Models.Ejemplar
@{
    ViewData["Title"] = "Editar Ejemplar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-edit me-2"></i>Editar Ejemplar</h1>
    <a asp-action="Index" asp-route-libroId="@Model.LibroId" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.Libro != null)
        {
            <div class="alert alert-info mb-4">
                <i class="fas fa-book me-2"></i>
                <strong>Libro:</strong> @Model.Libro.Titulo
                @if (!string.IsNullOrWhiteSpace(Model.Libro.Ubicacion))
                {
                    <span class="badge bg-light text-muted border ms-2">
                        <i class="fas fa-map-marker-alt me-1 text-primary"></i>Ubicación del libro: @Model.Libro.Ubicacion
                    </span>
                }
            </div>
        }

        @{
            var prestamoActivo = ViewBag.PrestamoActivo as BibliotecaVirtualWeb.Models.Prestamo;
        }

        @if (prestamoActivo != null)
        {
            <div class="alert alert-warning mb-4">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>⚠️ Préstamo Activo:</strong> Este ejemplar está actualmente prestado a 
                <strong>@prestamoActivo.Usuario?.NombreCompleto</strong> desde el 
                <strong>@prestamoActivo.FechaPrestamo.ToString("dd/MM/yyyy")</strong>.
                <br />
                <small class="text-muted">
                    Para cambiar el estado, primero debe devolver el préstamo desde el módulo de préstamos.
                </small>
            </div>
        }

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            
            <input type="hidden" name="Id" id="Id" value="@Model.Id" />
            <input type="hidden" name="LibroId" id="LibroId" value="@Model.LibroId" />

            <div class="mb-3">
                <label asp-for="CodigoBarras" class="form-label">Código de Barras</label>
                <input asp-for="CodigoBarras" class="form-control" />
                <span asp-validation-for="CodigoBarras" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ubicacion" class="form-label">Ubicación</label>
                <input asp-for="Ubicacion" class="form-control" placeholder="Ej: Estante A, Fila 3, Sección Infantil" />
                <small class="form-text text-muted">
                    <i class="fas fa-map-marker-alt me-1"></i>
                    Indica dónde se encuentra físicamente este ejemplar en la biblioteca.
                    Si quieres que siga la ubicación del libro, déjalo vacío; si necesitas
                    una ubicación personalizada, ingrésala aquí.
                </small>
                <span asp-validation-for="Ubicacion" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Prestado a</label>
                    @if (!string.IsNullOrWhiteSpace(Model.PrestadoA))
                    {
                        <div class="form-control-plaintext text-danger">
                            <i class="fas fa-user me-1"></i>@Model.PrestadoA
                        </div>
                    }
                    else
                    {
                        <div class="form-control-plaintext text-muted fst-italic">Sin préstamo activo</div>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha de préstamo</label>
                    @if (Model.FechaPrestamo.HasValue)
                    {
                        <div class="form-control-plaintext">
                            <i class="fas fa-clock me-1"></i>@Model.FechaPrestamo.Value.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    }
                    else
                    {
                        <div class="form-control-plaintext text-muted fst-italic">N/A</div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Estado" class="form-label">Estado</label>
                @{
                    var estadoDeshabilitado = prestamoActivo != null && Model.Estado != "Prestado" && Model.Estado != "Extraviado" && Model.Estado != "Dado de baja" && Model.Estado != "Deteriorado" && Model.Estado != "En Reparacion";
                }
                <select asp-for="Estado" class="form-select" id="estadoSelect" disabled="@estadoDeshabilitado">
                    <option value="Disponible">Disponible</option>
                    <option value="Prestado">Prestado</option>
                    <option value="Reservado">Reservado</option>
                    <option value="Deteriorado">Deteriorado</option>
                    <option value="En Reparacion">En Reparación</option>
                    <option value="Extraviado">Extraviado</option>
                    <option value="Dado de baja">Dado de baja</option>
                </select>
                @if (prestamoActivo != null && Model.Estado != "Prestado" && Model.Estado != "Extraviado" && Model.Estado != "Dado de baja" && Model.Estado != "Deteriorado" && Model.Estado != "En Reparacion")
                {
                    <small class="form-text text-warning">
                        <i class="fas fa-info-circle me-1"></i>
                        El estado está bloqueado porque existe un préstamo activo. Puede cambiarlo a "Deteriorado", "En Reparación", "Extraviado" o "Dado de baja".
                    </small>
                }
                else if (prestamoActivo == null && Model.Estado != "Prestado")
                {
                    <small class="form-text text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        Para cambiar a "Prestado", debe crear un préstamo desde el módulo de préstamos.
                    </small>
                }
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="mb-3 d-none" id="detallesEstadoBlock">
                <label for="detallesEstado" class="form-label">
                    <span id="detallesLabel">Describe el estado:</span>
                </label>
                <textarea id="detallesEstado" class="form-control" rows="3"
                          placeholder="Ej: Páginas sueltas, tapa despegada, etc."></textarea>
                <small class="form-text text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    Esta información se agregará a las notas automáticamente al guardar.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="Notas" class="form-label">Notas</label>
                <textarea asp-for="Notas" class="form-control" rows="3" id="notasTextarea"></textarea>
                <span asp-validation-for="Notas" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" asp-route-libroId="@Model.LibroId" class="btn btn-secondary">
                    <i class="fas fa-times me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const estadoSelect = document.getElementById('estadoSelect');
            const notasTextarea = document.getElementById('notasTextarea');
            const tienePrestamoActivo = @(prestamoActivo != null ? "true" : "false");
            const estadoActual = '@Model.Estado';
            const detallesBlock = document.getElementById('detallesEstadoBlock');
            const detallesTextarea = document.getElementById('detallesEstado');
            const detallesLabel = document.getElementById('detallesLabel');
            let estadoAnterior = estadoActual;
            
            // Estados que requieren detalles
            const estadosConDetalles = ['Deteriorado', 'En Reparacion'];
            
            if (estadoSelect) {
                estadoSelect.addEventListener('change', function () {
                    const nuevoEstado = this.value;
                    
                    // Validar "Prestado" sin préstamo activo
                    if (nuevoEstado === 'Prestado' && !tienePrestamoActivo) {
                        alert('⚠️ No se puede cambiar el estado a "Prestado" sin un préstamo activo.\n\n' +
                              'Debe crear un préstamo primero desde el módulo de préstamos.');
                        this.value = estadoAnterior;
                        return;
                    }
                    
                    // Si el nuevo estado requiere detalles, mostrar bloque inline
                    if (estadosConDetalles.includes(nuevoEstado)) {
                        // Configurar el bloque según el estado
                        if (nuevoEstado === 'Deteriorado') {
                            detallesLabel.textContent = 'Describe el deterioro:';
                            detallesTextarea.placeholder = 'Ej: Páginas sueltas, tapa despegada, manchas de agua, etc.';
                        } else if (nuevoEstado === 'En Reparacion') {
                            detallesLabel.textContent = 'Describe qué se está reparando:';
                            detallesTextarea.placeholder = 'Ej: Reparación de encuadernación, restauración de páginas, etc.';
                        }
                        
                        // Limpiar el textarea
                        detallesTextarea.value = '';
                        detallesBlock.classList.remove('d-none');
                        estadoAnterior = nuevoEstado;
                        detallesTextarea.focus();
                    } else {
                        // Si no requiere detalles, ocultar bloque y actualizar estado anterior
                        estadoAnterior = nuevoEstado;
                        detallesBlock.classList.add('d-none');
                        detallesTextarea.value = '';
                    }
                });
            }
            
            // Al enviar el formulario, si requiere detalles, validar y anexar a notas
            const form = document.querySelector('form');
            form.addEventListener('submit', function (e) {
                const estadoActualSel = estadoSelect.value;
                if (estadosConDetalles.includes(estadoActualSel)) {
                    const detalles = detallesTextarea.value.trim();
                    if (!detalles) {
                        e.preventDefault();
                        alert('⚠️ Por favor, ingresa los detalles del estado.');
                        detallesTextarea.focus();
                        return;
                    }

                    const fecha = new Date().toLocaleDateString('es-ES');
                    const prefijo = estadoActualSel === 'Deteriorado'
                        ? `[Deteriorado - ${fecha}] `
                        : `[En Reparación - ${fecha}] `;

                    const notasActuales = notasTextarea.value.trim();
                    const nuevaNota = prefijo + detalles;

                    if (notasActuales) {
                        notasTextarea.value = notasActuales + '\n\n' + nuevaNota;
                    } else {
                        notasTextarea.value = nuevaNota;
                    }
                }
            });
        });
    </script>
}

