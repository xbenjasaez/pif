@model BibliotecaVirtualWeb.Models.Ejemplar
@{
    ViewData["Title"] = "Nuevo Ejemplar";
    var libroId = ViewBag.LibroId as int?;
    var libroTitulo = ViewBag.LibroTitulo as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-plus me-2"></i>Nuevo Ejemplar</h1>
    <div>
        @if (libroId.HasValue)
        {
            <a asp-action="Index" asp-route-libroId="@libroId" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
        }
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    @if (libroId.HasValue)
                    {
                        <input type="hidden" name="LibroId" id="LibroId" value="@libroId.Value" />
                        <div class="alert alert-info">
                            <i class="fas fa-book me-2"></i>
                            <strong>Libro:</strong> @libroTitulo
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="LibroId" class="form-label">Libro</label>
                            <select asp-for="LibroId" class="form-select" required>
                                <option value="">Seleccione un libro</option>
                                @foreach (var l in (IEnumerable<dynamic>)ViewBag.Libros)
                                {
                                    <option value="@l.Id">@l.Titulo - @l.Autor</option>
                                }
                            </select>
                            <span asp-validation-for="LibroId" class="text-danger"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="CodigoBarras" class="form-label">Código de Barras</label>
                        <input asp-for="CodigoBarras" class="form-control" placeholder="Dejar vacío para generar automáticamente" />
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Si dejas este campo vacío, se generará un código único automáticamente.
                        </small>
                        <span asp-validation-for="CodigoBarras" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ubicacion" class="form-label">Ubicación</label>
                        <input asp-for="Ubicacion" class="form-control" placeholder="Ej: Estante A, Fila 3, Sección Infantil" />
                        <small class="form-text text-muted">
                            <i class="fas fa-map-marker-alt me-1"></i>
                            Indica dónde se encuentra físicamente este ejemplar en la biblioteca.
                        </small>
                        <span asp-validation-for="Ubicacion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label">Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Disponible" selected>Disponible</option>
                            <option value="Prestado">Prestado</option>
                            <option value="Reservado">Reservado</option>
                            <option value="En Reparacion">En Reparación</option>
                            <option value="Extraviado">Extraviado</option>
                            <option value="Dado de baja">Dado de baja</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notas" class="form-label">Notas</label>
                        <textarea asp-for="Notas" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notas" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" asp-route-libroId="@libroId" class="btn btn-secondary">
                            <i class="fas fa-times me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Crear Ejemplar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-layer-group me-2"></i>Crear múltiple</h5>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted mb-0">
                    Genera hasta 100 ejemplares en lote con códigos automáticos. Ideal cuando llegan varios ejemplares del mismo libro.
                </p>
                <form asp-action="CrearMultiple" method="post" class="d-flex flex-column gap-3">
                    @if (libroId.HasValue)
                    {
                        <input type="hidden" name="libroId" value="@libroId.Value" />
                        <div class="alert alert-info py-2 mb-0">
                            <i class="fas fa-book me-1"></i>
                            Se crearán para <strong>@libroTitulo</strong>.
                        </div>
                    }
                    else
                    {
                        <div>
                            <label for="libroIdMultiple" class="form-label">Libro</label>
                            <select id="libroIdMultiple" name="libroId" class="form-select" required>
                                <option value="">Selecciona un libro</option>
                                @foreach (var l in (IEnumerable<dynamic>)ViewBag.Libros)
                                {
                                    <option value="@l.Id">@l.Titulo - @l.Autor</option>
                                }
                            </select>
                        </div>
                    }

                    <div>
                        <label for="cantidadMultiple" class="form-label">Cantidad de ejemplares</label>
                        <input type="number" name="cantidad" id="cantidadMultiple" class="form-control" min="1" max="100" value="1" required />
                        <small class="form-text text-muted">Máximo 100 ejemplares a la vez.</small>
                    </div>

                    <div>
                        <label for="prefijoCodigoMultiple" class="form-label">Prefijo para el código (opcional)</label>
                        <input type="text" name="prefijoCodigo" id="prefijoCodigoMultiple" class="form-control" maxlength="20" placeholder="Ej: BIB-2025" />
                        <small class="form-text text-muted">Genera códigos como PREFIJO000001, PREFIJO000002, etc.</small>
                    </div>

                    <div class="alert alert-warning small mb-0">
                        <i class="fas fa-info-circle me-1"></i> Los códigos duplicados se regeneran automáticamente para evitar conflictos.
                    </div>

                    <button type="submit" class="btn btn-success w-100 mt-auto">
                        <i class="fas fa-layer-group me-1"></i>Crear múltiples ejemplares
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

