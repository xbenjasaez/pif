@using System.Linq
@model BibliotecaVirtualWeb.Models.EjemplaresImprimirViewModel
@{
    ViewData["Title"] = "Documento de códigos de barras";
}

<style>
    .print-toolbar {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #ffffff;
        border-bottom: 1px solid #e5e5e5;
        padding: 1rem 0;
        margin-bottom: 1.5rem;
    }

.barcode-page {
    page-break-after: always;
    padding-bottom: 1.5rem;
}

.barcode-page:last-child {
    page-break-after: auto;
}

.barcode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    min-height: 10rem;
}

    .barcode-card {
        border: 1px solid #d9d9d9;
        border-radius: 0.5rem;
        padding: 1rem;
        background-color: #fff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
        page-break-inside: avoid;
    }

    .barcode-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 5cm;
    height: 2.5cm;
    margin: 0 auto;
}

.barcode-wrapper svg {
    width: 5cm !important;
    height: 2cm !important;
    }

    @@media print {
        body {
            margin: 0.5cm;
            background-color: #ffffff !important;
        }

        .print-toolbar,
        .breadcrumb,
        nav.navbar,
        footer {
            display: none !important;
        }

        .barcode-card {
            box-shadow: none;
        }
    }
</style>

<div class="print-toolbar d-print-none">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <h1 class="h4 mb-1">@Model.TituloDocumento</h1>
            <p class="text-muted mb-0">Generado el @Model.GeneradoEl.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" onclick="window.print()">
                <i class="fas fa-print me-1"></i>Imprimir
            </button>
            <a asp-action="Index" asp-route-libroId="@Model.LibroId" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver a ejemplares
            </a>
        </div>
    </div>
</div>

@foreach (var grupo in Model.Ejemplares.Chunk(8))
{
    <div class="barcode-page">
        <div class="barcode-grid">
            @foreach (var ejemplar in grupo)
            {
                <div class="barcode-card">
                    <div class="mb-2">
                        <span class="text-muted small text-uppercase">Ejemplar</span><br />
                        <strong>@(ejemplar.Libro?.Titulo ?? "Sin título")</strong>
                    </div>
                    <div class="barcode-wrapper">
                        <svg class="barcode-svg" data-code="@ejemplar.CodigoBarras"></svg>
                    </div>
                    <div class="text-center mt-2">
                        <span class="fw-semibold">@ejemplar.CodigoBarras</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cards = document.querySelectorAll(".barcode-svg");
            cards.forEach((el) => {
                const rawCode = (el.dataset.code || "").trim();
                const digitsOnly = rawCode.replace(/\D/g, "");

                if (digitsOnly.length < 12 || digitsOnly.length > 13) {
                    el.insertAdjacentHTML("afterend", "<small class='text-danger'>Código inválido</small>");
                    return;
                }

                const eanValue = digitsOnly.length === 12
                    ? digitsOnly
                    : digitsOnly;

                JsBarcode(el, eanValue, {
                    format: "EAN13",
                    lineColor: "#000000",
                    width: 1.6,
                    height: 60,
                    displayValue: true,
                    fontSize: 14,
                    margin: 0,
                    flat: true
                });

                el.style.width = "5cm";
                el.style.height = "2cm";
            });

            const autoPrint = @Model.AutoPrint.ToString().ToLower();
            if (autoPrint) {
                window.print();
            }
        });
    </script>
}

