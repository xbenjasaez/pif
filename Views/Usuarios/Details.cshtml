@model BibliotecaVirtualWeb.Models.Usuario
@{
    ViewData["Title"] = "Detalles del Usuario";
    var prestamos = (ViewBag.Prestamos as IEnumerable<BibliotecaVirtualWeb.Models.Prestamo> ?? Enumerable.Empty<BibliotecaVirtualWeb.Models.Prestamo>()).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary"><i class="fas fa-user me-2"></i>Detalles del Usuario</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-edit me-1"></i>Editar</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Volver</a>
    </div>
    
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>
            <dt class="col-sm-3">Apellido</dt>
            <dd class="col-sm-9">@Model.Apellido</dd>
            <dt class="col-sm-3">RUT</dt>
            <dd class="col-sm-9">@Model.RUT</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Telefono</dd>
            <dt class="col-sm-3">Curso</dt>
            <dd class="col-sm-9">@Model.Curso</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><span class="@Model.EstadoBadgeClass">@Model.Estado</span></dd>
            <dt class="col-sm-3">Fecha Registro</dt>
            <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Notas</dt>
            <dd class="col-sm-9">@Model.Notas</dd>
        </dl>
    </div>
</div>

<div class="card shadow">
    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-history me-2"></i>Historial reciente</h5>
        <small class="text-muted">Últimos @prestamos.Count() movimientos</small>
    </div>
    <div class="card-body">
        @if (prestamos.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Libro</th>
                            <th>Fecha préstamo</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prestamo in prestamos)
                        {
                            <tr>
                                <td>
                                    <strong>@(prestamo.Ejemplar?.Libro?.Titulo ?? prestamo.Libro?.Titulo ?? "Sin título")</strong>
                                    <div class="small text-muted">Código: @prestamo.Ejemplar?.CodigoBarras</div>
                                </td>
                                <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                                <td>@prestamo.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        var badgeClass = prestamo.Estado switch
                                        {
                                            "Activo" => "badge bg-warning text-dark",
                                            "Devuelto" => "badge bg-success",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@badgeClass">@prestamo.Estado</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="fas fa-inbox fa-3x mb-2"></i>
                <p class="mb-0">Este usuario aún no registra préstamos.</p>
            </div>
        }
    </div>
</div>
