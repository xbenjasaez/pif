@using System.Linq
@model IEnumerable<BibliotecaVirtualWeb.Models.Usuario>
@{
    Layout = null;
    var alumnos = Model.ToList();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Credenciales de alumnos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .print-toolbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #ffffff;
            border-bottom: 1px solid #e5e5e5;
            padding: 1rem 0;
            margin-bottom: 1.5rem;
        }

        .barcode-page {
            page-break-after: always;
            padding-bottom: 1.5rem;
        }

        .barcode-page:last-child {
            page-break-after: auto;
        }

        .barcode-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1rem;
            min-height: 10rem;
        }

        .barcode-card {
            border: 1px solid #d9d9d9;
            border-radius: 0.5rem;
            padding: 1rem;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
            page-break-inside: avoid;
        }

        .barcode-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 5cm;
            height: 2.5cm;
            margin: 0 auto;
        }

        .barcode-wrapper svg {
            width: 5cm !important;
            height: 2cm !important;
        }

        .credential-info {
            margin-bottom: 0.5rem;
        }

        .credential-info .small {
            font-size: 0.75rem;
            color: #6c757d;
            text-transform: uppercase;
        }

        .credential-info strong {
            font-size: 0.85rem;
            display: block;
            margin-top: 0.25rem;
        }

        .credential-info .text-muted {
            font-size: 0.8rem;
            margin-top: 0.15rem;
        }

        @@media print {
            body {
                margin: 0.5cm;
                background-color: #ffffff !important;
            }

            .print-toolbar {
                display: none !important;
            }

            .barcode-card {
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <div class="print-toolbar d-print-none">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h1 class="h4 mb-1">Credenciales de Alumnos</h1>
                <p class="text-muted mb-0">Total: @alumnos.Count credenciales</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="fas fa-print me-1"></i>Imprimir
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Volver
                </a>
            </div>
        </div>
    </div>

    @foreach (var grupo in alumnos.Chunk(8))
    {
        <div class="barcode-page">
            <div class="barcode-grid">
                @foreach (var alumno in grupo)
                {
                    var curso = string.IsNullOrWhiteSpace(alumno.CursoConLetra) ? "N/D" : alumno.CursoConLetra;
                    <div class="barcode-card">
                        <div class="credential-info">
                            <span class="small">Biblioteca Escolar</span>
                            <strong>@alumno.NombreCompleto</strong>
                            <div class="text-muted">@curso</div>
                            <div class="text-muted" style="font-size: 0.75rem;">RUT: @alumno.RUT</div>
                        </div>
                        <div class="barcode-wrapper">
                            <svg class="barcode-svg" data-rut="@alumno.RUT"></svg>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        function rutToEan13(rawRut) {
            const digits = (rawRut || "").replace(/\D/g, "");
            if (!digits) {
                return null;
            }
            const padded = digits.padStart(12, "0");
            return padded.slice(-12);
        }

        document.addEventListener("DOMContentLoaded", function () {
            const cards = document.querySelectorAll(".barcode-svg");
            cards.forEach((el) => {
                const rut = el.dataset.rut || "";
                const eanValue = rutToEan13(rut);

                if (!eanValue) {
                    el.insertAdjacentHTML("afterend", "<small class='text-danger'>RUT inválido</small>");
                    return;
                }

                JsBarcode(el, eanValue, {
                    format: "EAN13",
                    lineColor: "#000000",
                    width: 1.6,
                    height: 60,
                    displayValue: true,
                    fontSize: 14,
                    margin: 0,
                    flat: true
                });

                el.style.width = "5cm";
                el.style.height = "2cm";
            });
        });
    </script>
</body>
</html>
