@model IEnumerable<BibliotecaVirtualWeb.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary">
        <i class="fas fa-users me-2"></i>Gestión de Usuarios
    </h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-1"></i>Agregar Usuario
    </a>
</div>

<!-- Filtros -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-filter me-2"></i>Filtros de Búsqueda
        </h6>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <label for="searchString" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="searchString" name="searchString" 
                       value="@ViewBag.SearchString" placeholder="Nombre, apellido, RUT o email...">
            </div>
            <div class="col-md-4">
                <label for="estado" class="form-label">Estado</label>
                <select class="form-select" id="estado" name="estado">
                    <option value="">Todos los estados</option>
                    <option value="Activo" selected="@(ViewBag.EstadoSeleccionado == "Activo")">Activo</option>
                    <option value="Inactivo" selected="@(ViewBag.EstadoSeleccionado == "Inactivo")">Inactivo</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="fas fa-search me-1"></i>Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Lista de Usuarios -->
<div class="card shadow">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-list me-2"></i>Lista de Usuarios (@Model.Count())
        </h6>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre Completo</th>
                            <th>RUT</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Curso</th>
                            <th>Estado</th>
                            <th>Préstamos Activos</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@usuario.NombreCompleto</div>
                                    <small class="text-muted">Registrado: @usuario.FechaRegistro.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    <code>@usuario.RUT</code>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(usuario.Email))
                                    {
                                        <a href="mailto:@usuario.Email" class="text-decoration-none">@usuario.Email</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(usuario.Telefono))
                                    {
                                        <a href="tel:@usuario.Telefono" class="text-decoration-none">@usuario.Telefono</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(usuario.Curso))
                                    {
                                        <span class="badge bg-light text-dark">@usuario.Curso</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="@usuario.EstadoBadgeClass">@usuario.Estado</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-primary me-1">@usuario.PrestamosActivos</span>
                                        @if (usuario.PrestamosVencidos > 0)
                                        {
                                            <span class="badge bg-danger">@usuario.PrestamosVencidos vencidos</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@usuario.Id" 
                                           class="btn btn-outline-info btn-sm" title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@usuario.Id" 
                                           class="btn btn-outline-warning btn-sm" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@usuario.Id" 
                                           class="btn btn-outline-danger btn-sm" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-users fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No se encontraron usuarios</h4>
                <p class="text-muted">Intenta ajustar los filtros de búsqueda o agrega algunos usuarios al sistema.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-user-plus me-1"></i>Agregar Primer Usuario
                </a>
            </div>
        }
    </div>
</div>
