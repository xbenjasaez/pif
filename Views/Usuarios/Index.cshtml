@model IEnumerable<BibliotecaVirtualWeb.Models.Usuario>
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Usuarios";

    var cursosOrden = new List<string>
    {
        "Prekínder","Kínder","1° Básico","2° Básico","3° Básico","4° Básico",
        "5° Básico","6° Básico","7° Básico","8° Básico","1° Medio","2° Medio",
        "3° Medio","4° Medio","Sin curso"
    };

    int CursoOrden(string curso)
    {
        var idx = cursosOrden.IndexOf(curso);
        return idx >= 0 ? idx : cursosOrden.Count;
    }

    // Separar profesores y alumnos
    var profesores = Model.Where(u => u.TipoUsuario == "Profesor").OrderBy(u => u.Apellido).ThenBy(u => u.Nombre).ToList();
    var alumnos = Model.Where(u => u.TipoUsuario == "Alumno" || string.IsNullOrWhiteSpace(u.TipoUsuario)).ToList();

    var gruposAlumnos = alumnos
        .GroupBy(u => string.IsNullOrWhiteSpace(u.Curso) ? "Sin curso" : u.Curso)
        .OrderBy(g => CursoOrden(g.Key))
        .ThenBy(g => g.Key)
        .ToList();

    string Slugify(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "grupo";
        }
        var normalized = text.ToLowerInvariant();
        normalized = Regex.Replace(normalized, @"[^a-z0-9]+", "-");
        return normalized.Trim('-');
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-primary">
        <i class="fas fa-users me-2"></i>Gestión de Usuarios
    </h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-1"></i>Agregar Usuario
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Selección por curso (alumnos)
            document.querySelectorAll(".seleccionar-curso").forEach(master => {
                master.addEventListener("change", function () {
                    const curso = this.dataset.curso;
                    document.querySelectorAll(`.seleccionar-credencial[data-curso='${curso}']`)
                        .forEach(chk => chk.checked = this.checked);
                });
            });

            // Selección de todos los profesores
            const selectAllProfesores = document.getElementById("select-all-profesores");
            if (selectAllProfesores) {
                selectAllProfesores.addEventListener("change", function () {
                    document.querySelectorAll(".seleccionar-credencial-profesor")
                        .forEach(chk => chk.checked = this.checked);
                });
            }

            // Cambiar ícono del chevron al expandir/colapsar
            document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
                const targetId = button.getAttribute('data-bs-target');
                const target = document.querySelector(targetId);
                if (target) {
                    const icon = button.querySelector('.fa-chevron-down, .fa-chevron-up');
                    if (icon) {
                        target.addEventListener('shown.bs.collapse', function() {
                            icon.classList.remove('fa-chevron-down');
                            icon.classList.add('fa-chevron-up');
                        });
                        target.addEventListener('hidden.bs.collapse', function() {
                            icon.classList.remove('fa-chevron-up');
                            icon.classList.add('fa-chevron-down');
                        });
                    }
                }
            });
        });
    </script>
}

<!-- Filtros -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-filter me-2"></i>Filtros de Búsqueda
        </h6>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <label for="searchString" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="searchString" name="searchString" 
                       value="@ViewBag.SearchString" placeholder="Nombre, apellido, RUT o email...">
            </div>
            <div class="col-md-3">
                <label for="estado" class="form-label">Estado</label>
                <select class="form-select" id="estado" name="estado">
                    <option value="">Todos los estados</option>
                    <option value="Activo" selected="@(ViewBag.EstadoSeleccionado == "Activo")">Activo</option>
                    <option value="Inactivo" selected="@(ViewBag.EstadoSeleccionado == "Inactivo")">Inactivo</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="tipoUsuario" class="form-label">Tipo</label>
                <select class="form-select" id="tipoUsuario" name="tipoUsuario">
                    <option value="">Todos los tipos</option>
                    <option value="Alumno" selected="@(ViewBag.TipoUsuarioSeleccionado == "Alumno")">Alumno</option>
                    <option value="Profesor" selected="@(ViewBag.TipoUsuarioSeleccionado == "Profesor")">Profesor</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2 w-100">
                    <i class="fas fa-search me-1"></i>Buscar
                </button>
            </div>
            <div class="col-md-12 mt-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-times me-1"></i>Limpiar filtros
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Lista de Profesores -->
@if (profesores.Any())
{
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-info bg-opacity-10 border-info">
            <h6 class="m-0 font-weight-bold text-info">
                <i class="fas fa-chalkboard-teacher me-2"></i>Profesores (@profesores.Count())
            </h6>
        </div>
        <div class="card-body">
            <form asp-action="ImprimirCredenciales" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input class="form-check-input seleccionar-todos-profesores" type="checkbox" id="select-all-profesores">
                        <label class="form-check-label" for="select-all-profesores">
                            Seleccionar todos los profesores
                        </label>
                    </div>
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-id-card me-1"></i>Imprimir seleccionados
                    </button>
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var profesor in profesores)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm border-info">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="card-title mb-1">@profesor.NombreCompleto</h5>
                                            <small class="text-muted">Inscrito: @profesor.FechaRegistro.ToString("dd/MM/yyyy")</small>
                                        </div>
                                        <span class="@profesor.EstadoBadgeClass">@profesor.Estado</span>
                                    </div>
                                    <p class="mb-1">
                                        <i class="fas fa-chalkboard-teacher me-2 text-info"></i>
                                        <strong>Profesor</strong>
                                    </p>
                                    <p class="mb-1">
                                        <i class="fas fa-id-card me-2 text-primary"></i>
                                        <strong>@profesor.RUT</strong>
                                    </p>
                                    <p class="mb-1 text-muted">
                                        <i class="fas fa-envelope me-2"></i>
                                        @(string.IsNullOrWhiteSpace(profesor.Email) ? "Sin email" : profesor.Email)
                                    </p>
                                    <p class="mb-3 text-muted">
                                        <i class="fas fa-phone me-2"></i>
                                        @(string.IsNullOrWhiteSpace(profesor.Telefono) ? "Sin teléfono" : profesor.Telefono)
                                    </p>
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        <span class="badge bg-primary">
                                            Préstamos activos: @profesor.PrestamosActivos
                                        </span>
                                        @if (profesor.PrestamosVencidos > 0)
                                        {
                                            <span class="badge bg-danger">
                                                Vencidos: @profesor.PrestamosVencidos
                                            </span>
                                        }
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input seleccionar-credencial-profesor" type="checkbox" name="seleccionados" value="@profesor.Id" id="cred-prof-@profesor.Id">
                                        <label class="form-check-label" for="cred-prof-@profesor.Id">
                                            Incluir en este lote
                                        </label>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-0 pt-0">
                                    <div class="btn-group w-100" role="group">
                                        <a asp-action="Details" asp-route-id="@profesor.Id"
                                           class="btn btn-outline-info btn-sm" title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@profesor.Id"
                                           class="btn btn-outline-warning btn-sm" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Credencial" asp-route-id="@profesor.Id" target="_blank"
                                           class="btn btn-outline-primary btn-sm" title="Imprimir credencial individual">
                                            <i class="fas fa-id-badge"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@profesor.Id"
                                           class="btn btn-outline-danger btn-sm" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>
}

<!-- Lista de Alumnos -->
<div class="card shadow">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-layer-group me-2"></i>Alumnos totales (@alumnos.Count())
        </h6>
    </div>
    <div class="card-body">
        @if (gruposAlumnos.Any())
        {
            <div class="row g-3">
                @for (var i = 0; i < gruposAlumnos.Count; i++)
                {
                    var grupo = gruposAlumnos[i];
                    var collapseId = $"curso-{Slugify(grupo.Key)}";
                    <div class="col-12">
                        <div class="card shadow-sm border-primary mb-3">
                            <div class="card-header bg-primary bg-opacity-10 border-primary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <h5 class="mb-0">
                                            <i class="fas fa-graduation-cap me-2 text-primary"></i>
                                            <strong>@grupo.Key</strong>
                                        </h5>
                                        <span class="badge bg-primary text-white">@grupo.Count() alumno(s)</span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")">
                                        <i class="fas @(i == 0 ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                        <span class="d-none d-md-inline ms-1">Ver alumnos</span>
                                    </button>
                                </div>
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-info-circle me-1"></i>
                                    @(grupo.Key == "Sin curso" ? "Alumnos sin curso asignado" : "Alumnos inscritos en este curso")
                                </small>
                            </div>
                            <div id="@collapseId" class="collapse @(i == 0 ? "show" : string.Empty)">
                                <div class="card-body">
                                <form asp-action="ImprimirCredenciales" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input seleccionar-curso" type="checkbox" data-curso="@collapseId" id="curso-select-@collapseId">
                                            <label class="form-check-label" for="curso-select-@collapseId">
                                                Seleccionar todos
                                            </label>
                                        </div>
                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-id-card me-1"></i>Imprimir seleccionados
                                        </button>
                                    </div>
                                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                                        @foreach (var usuario in grupo.OrderBy(u => u.LetraCurso).ThenBy(u => u.Apellido).ThenBy(u => u.Nombre))
                                        {
                                            <div class="col">
                                                <div class="card h-100 border-0 shadow-sm">
                                                    <div class="card-body">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <div>
                                                                <h5 class="card-title mb-1">@usuario.NombreCompleto</h5>
                                                                <small class="text-muted">Inscrito: @usuario.FechaRegistro.ToString("dd/MM/yyyy")</small>
                                                            </div>
                                                            <span class="@usuario.EstadoBadgeClass">@usuario.Estado</span>
                                                        </div>
                                                        <p class="mb-1">
                                                            <i class="fas fa-chalkboard-teacher me-2 text-primary"></i>
                                                            @(string.IsNullOrWhiteSpace(usuario.CursoConLetra)
                                                                ? "Sin curso asignado"
                                                                : usuario.CursoConLetra)
                                                        </p>
                                                        <p class="mb-1">
                                                            <i class="fas fa-id-card me-2 text-primary"></i>
                                                            <strong>@usuario.RUT</strong>
                                                        </p>
                                                        <p class="mb-1 text-muted">
                                                            <i class="fas fa-envelope me-2"></i>
                                                            @(string.IsNullOrWhiteSpace(usuario.Email) ? "Sin email" : usuario.Email)
                                                        </p>
                                                        <p class="mb-3 text-muted">
                                                            <i class="fas fa-phone me-2"></i>
                                                            @(string.IsNullOrWhiteSpace(usuario.Telefono) ? "Sin teléfono" : usuario.Telefono)
                                                        </p>
                                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                                            <span class="badge bg-primary">
                                                                Préstamos activos: @usuario.PrestamosActivos
                                                            </span>
                                                            @if (usuario.PrestamosVencidos > 0)
                                                            {
                                                                <span class="badge bg-danger">
                                                                    Vencidos: @usuario.PrestamosVencidos
                                                                </span>
                                                            }
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input seleccionar-credencial" type="checkbox" name="seleccionados" value="@usuario.Id" data-curso="@collapseId" id="cred-@usuario.Id">
                                                            <label class="form-check-label" for="cred-@usuario.Id">
                                                                Incluir en este lote
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="card-footer bg-transparent border-0 pt-0">
                                                        <div class="btn-group w-100" role="group">
                                                            <a asp-action="Details" asp-route-id="@usuario.Id"
                                                               class="btn btn-outline-info btn-sm" title="Ver detalles">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                            <a asp-action="Edit" asp-route-id="@usuario.Id"
                                                               class="btn btn-outline-warning btn-sm" title="Editar">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            <a asp-action="Credencial" asp-route-id="@usuario.Id" target="_blank"
                                                               class="btn btn-outline-primary btn-sm" title="Imprimir credencial individual">
                                                                <i class="fas fa-id-badge"></i>
                                                            </a>
                                                            <a asp-action="Delete" asp-route-id="@usuario.Id"
                                                               class="btn btn-outline-danger btn-sm" title="Eliminar">
                                                                <i class="fas fa-trash"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-users fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No se encontraron alumnos</h4>
                <p class="text-muted">Intenta ajustar los filtros de búsqueda o agrega algunos alumnos al sistema.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-user-plus me-1"></i>Agregar Primer Alumno
                </a>
            </div>
        }
    </div>
</div>
