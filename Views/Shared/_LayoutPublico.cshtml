<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca Escolar</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="CatalogoPublico" asp-action="Index">
                    <i class="fas fa-book-reader me-2"></i>Biblioteca Escolar
                </a>
                
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-primary d-none d-md-inline">
                        <i class="fas fa-globe me-1"></i>Catálogo Público
                    </span>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm">
                        <i class="fas fa-sign-in-alt me-1"></i>Personal
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <i class="fas fa-book-open me-2"></i>
                    <strong>Biblioteca Escolar</strong>
                    <span class="ms-2 text-muted">© @DateTime.Now.Year</span>
                </div>
                <div class="col-md-6 text-center text-md-end text-muted">
                    <small>
                        <i class="fas fa-clock me-1"></i>Lunes a Viernes, 8:00 - 17:00
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
