@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="alert alert-danger">
        <h1 class="display-4">
            <i class="fas fa-exclamation-triangle me-2"></i>Ocurrió un error
        </h1>
        <hr>
        
        @if (ViewBag.ErrorMessage != null)
        {
            <h4>Mensaje de Error:</h4>
            <p class="lead">@ViewBag.ErrorMessage</p>
        }
        
        @if (ViewBag.ErrorDetail != null)
        {
            <hr>
            <h5>Detalle Completo:</h5>
            <pre style="background: #f5f5f5; padding: 15px; border-radius: 5px; overflow-x: auto;">@ViewBag.ErrorDetail</pre>
        }
        
        <hr>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-home me-1"></i>Ir al Inicio
        </a>
        <a href="javascript:history.back()" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

