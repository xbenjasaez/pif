@using Microsoft.AspNetCore.Identity
@using BibliotecaVirtualWeb.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca Virtual</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                const storedTheme = localStorage.getItem('bv-theme');
                const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                const theme = storedTheme || (prefersDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href='data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"%3E%3Crect width="64" height="64" rx="12" fill="%232b50ff"/%3E%3Cpath d="M20 18h20a6 6 0 0 1 6 6v22a2 2 0 0 1-3.06 1.7L32 41l-10.94 6.7A2 2 0 0 1 18 46V24a6 6 0 0 1 6-6Z" fill="%23fff"/%3E%3Cpath d="M26 24h16" stroke="%232b50ff" stroke-width="3" stroke-linecap="round"/%3E%3Cpath d="M26 32h12" stroke="%232b50ff" stroke-width="3" stroke-linecap="round"/%3E%3C/svg%3E' />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm navbar-compact">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-book me-2"></i>Biblioteca Virtual
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse px-2" id="navbarNav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                    <ul class="navbar-nav me-auto flex-row flex-wrap flex-lg-nowrap gap-1 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-boxes me-1"></i>Inventario
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Inventario" asp-action="Index">
                                    <i class="fas fa-search me-2"></i>Búsqueda General
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Libros</h6></li>
                                <li><a class="dropdown-item" asp-controller="Libros" asp-action="Catalogo">
                                    <i class="fas fa-book-open me-2"></i>Catálogo de Libros
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Libros" asp-action="Index">
                                    <i class="fas fa-cog me-2"></i>Gestión de Libros
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Libros" asp-action="Create">
                                    <i class="fas fa-plus me-2"></i>Agregar Libro
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Ejemplares</h6></li>
                                <li><a class="dropdown-item" asp-controller="Ejemplares" asp-action="Index">
                                    <i class="fas fa-copy me-2"></i>Buscar Ejemplares
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Ejemplares" asp-action="Create">
                                    <i class="fas fa-plus me-2"></i>Agregar Ejemplar
                                </a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-users me-1"></i>Usuarios
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                    <i class="fas fa-list me-2"></i>Ver Todos
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Create">
                                    <i class="fas fa-user-plus me-2"></i>Agregar Usuario
                                </a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-truck me-1"></i>Proveedores
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Proveedores" asp-action="Index">
                                    <i class="fas fa-list me-2"></i>Ver Todos
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Proveedores" asp-action="Create">
                                    <i class="fas fa-plus me-2"></i>Agregar Proveedor
                                </a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-hand-holding me-1"></i>Préstamos
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Prestamos" asp-action="PrestamoRapido">
                                    <i class="fas fa-qrcode me-2"></i>Préstamo Rápido
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Prestamos" asp-action="DevolucionRapida">
                                    <i class="fas fa-barcode me-2"></i>Devolución Rápida
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Prestamos" asp-action="Index">
                                    <i class="fas fa-list me-2"></i>Ver Todos los Préstamos
                                </a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="RegistroCirculacion" asp-action="Index">
                                <i class="fas fa-clipboard-list me-1"></i>Registro de Circulación
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-chart-bar me-1"></i>Reportes
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Index">
                                    <i class="fas fa-chart-pie me-2"></i>Ver Reportes
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Exportacion" asp-action="Index">
                                    <i class="fas fa-file-export me-2"></i>Exportar a Excel/PDF
                                </a></li>
                            </ul>
                        </li>
                        <li class="nav-item d-lg-none">
                            <a class="nav-link text-primary fw-semibold" asp-controller="Prestamos" asp-action="PrestamoRapido">
                                <i class="fas fa-qrcode me-1"></i>Préstamo Rápido
                            </a>
                        </li>
                        <li class="nav-item d-lg-none">
                            <a class="nav-link text-warning fw-semibold" asp-controller="Prestamos" asp-action="DevolucionRapida">
                                <i class="fas fa-barcode me-1"></i>Devolución Rápida
                            </a>
                        </li>
                        <li class="nav-item d-lg-none">
                            <div class="d-flex align-items-center px-3 py-2">
                                <button type="button" class="btn btn-outline-light w-100 theme-toggle" data-theme-toggle id="themeToggleMobile">
                                    <i class="fas fa-moon me-2"></i><span>Cambiar tema</span>
                                </button>
                            </div>
                        </li>
                        <li class="nav-item d-lg-none">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-2">
                                <button type="submit" class="btn btn-outline-light w-100">
                                    <i class="fas fa-sign-out-alt me-1"></i>Cerrar sesión
                                </button>
                            </form>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-shield-alt me-1"></i>Administración
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="AdminUsuarios" asp-action="Index">
                                        <i class="fas fa-users-cog me-2"></i>Usuarios internos
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Importacion" asp-action="Index">
                                        <i class="fas fa-cloud-upload-alt me-2"></i>Importar datos
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Backup" asp-action="Index">
                                        <i class="fas fa-database me-2"></i>Respaldos
                                    </a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link fw-semibold" asp-controller="Account" asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        </ul>
                    }
                </div>
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="d-none d-lg-flex gap-2 align-items-center">
                        <button type="button" class="btn btn-outline-light btn-sm theme-toggle" data-theme-toggle id="themeToggle" aria-label="Cambiar tema">
                            <i class="fas fa-moon"></i>
                        </button>
                        <a class="btn btn-primary btn-sm fw-semibold navbar-quick-btn" asp-controller="Prestamos" asp-action="PrestamoRapido">
                            <i class="fas fa-qrcode me-1"></i>Préstamo Rápido
                        </a>
                        <a class="btn btn-warning btn-sm text-dark fw-semibold navbar-quick-btn" asp-controller="Prestamos" asp-action="DevolucionRapida">
                            <i class="fas fa-barcode me-1"></i>Devolución Rápida
                        </a>
                        <div class="dropdown">
                            <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-label="Menú de usuario">
                                <i class="fas fa-user-circle fa-lg"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><span class="dropdown-item-text text-muted small">Sesión iniciada</span></li>
                                <li><span class="dropdown-item-text text-break fw-semibold">@User.Identity?.Name</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                        <button type="submit" class="btn btn-link text-danger text-decoration-none p-0">
                                            <i class="fas fa-sign-out-alt me-1"></i>Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="container-fluid py-4">
        <!-- Alertas -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="bg-light text-center text-muted py-3 mt-5">
        <div class="container">
            <p class="mb-0">
                &copy; @DateTime.Now.Year - Biblioteca Escolar
            </p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @if (SignInManager.IsSignedIn(User))
    {
    <!-- Script anti-caché para páginas autenticadas -->
    <script>
        (function() {
            // Solo verificar cuando la página se carga desde el caché (botón atrás/adelante)
            window.addEventListener('pageshow', function(event) {
                // event.persisted = true cuando la página viene del bfcache (back-forward cache)
                if (event.persisted) {
                    // Verificar si la sesión sigue activa
                    fetch('/Account/CheckSession', { 
                        method: 'GET',
                        credentials: 'same-origin',
                        cache: 'no-store'
                    })
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (!data.authenticated) {
                            window.location.replace('/Account/Login');
                        }
                    })
                    .catch(function() {
                        window.location.replace('/Account/Login');
                    });
                }
            });
        })();
    </script>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
